---
// "Our Story": a sticky stage where scrolling rolls a film-reel wheel.
// Slides sit on the rim of a big wheel centred on the right edge of the
// screen; scroll progress rotates the wheel so the next slide rolls up
// into the reading position, and the text panel on the left follows.
interface Item { no: string; h: string; t: string; p: string[] }
interface Props { c: { h: string; items: Item[] } }
const { c } = Astro.props;

const SLOTS = 10;                 // total frames on the reel (extras are empty frames)
const STEP = 360 / SLOTS;         // degrees between frames
const frames = Array.from({ length: SLOTS }, (_, i) => c.items[i] ?? null);
---
<section class="story story--stacked" id="story" data-count={c.items.length} data-step={STEP} style={`--n:${c.items.length}`}>
  <div class="stage">
    <div class="copy">
      <h2>{c.h}</h2>
      <div class="panels">
        {c.items.map((it, i) => (
          <article class={`panel${i === 0 ? ' on' : ''}`} data-i={i}>
            <p class="kicker">{it.no} · {it.h}</p>
            <h3>{it.t}</h3>
            {it.p.map((para) => <p class="body">{para}</p>)}
          </article>
        ))}
      </div>
    </div>

    <div class="wheel" aria-hidden="true">
      <div class="ring"></div>
      <div class="hub"></div>
      {frames.map((it, i) => (
        <div class="frame" style={`--a:${-i * STEP}deg`}>
          <div class={`slide${it ? '' : ' empty'}${i === 0 ? ' on' : ''}`} data-i={it ? i : undefined}>
            {it && <span><b>{it.no}</b>{it.h}</span>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .story {
    /* scroll distance = one screen per slide transition + one to settle */
    height: calc(var(--n) * 90vh + 100vh);
    /* palette: site brand blue + one sun-yellow accent, cream text */
    --wbg: var(--brand, #2F52A8);
    --wface: color-mix(in srgb, var(--wbg) 80%, #fff);
    --wdeep: color-mix(in srgb, var(--wbg) 80%, #081742);
    --wsun: var(--sun, #E9B949);
    --wcream: #F6EEDC;
    background: radial-gradient(120% 100% at 100% 50%, color-mix(in srgb, var(--wbg) 86%, #fff) 0%, var(--wbg) 55%, var(--wdeep) 100%);
    color: var(--wcream);
  }
  .stage {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    --D: 150vh;               /* wheel diameter */
    --R: 60vh;                /* distance from hub to slide centres */
    --sw: 36vh;               /* slide width */
    display: grid; grid-template-columns: minmax(300px, 0.95fr) 1.05fr;
    align-items: center;
    padding-inline: max(1.5rem, calc((100vw - 1180px) / 2));
  }

  /* ---- text ---- */
  .copy { position: relative; z-index: 2; max-width: 34rem; }
  .copy h2 { margin: 0 0 1rem; color: var(--wcream); }
  /* all panels share one grid cell, so the box is as tall as the longest one */
  .panels { display: grid; }
  .panel {
    grid-area: 1 / 1;
    opacity: 0; transform: translateY(24px);
    transition: opacity .45s ease, transform .45s ease;
    pointer-events: none;
  }
  .panel.on { opacity: 1; transform: none; pointer-events: auto; }
  .panel .kicker {
    margin: 0 0 .4rem; font-weight: 700; letter-spacing: .12em; font-size: .8rem;
    text-transform: uppercase; color: rgba(246, 238, 220, .7);
  }
  .panel h3 { margin: 0 0 .8rem; font-size: clamp(1.3rem, 2.3vw, 1.75rem); line-height: 1.25; color: var(--wsun); text-wrap: balance; }
  .panel .body { margin: 0 0 .7rem; font-size: clamp(.85rem, 1.05vw + .35vh, .98rem); color: rgba(246, 238, 220, .9); line-height: 1.65; }

  /* ---- wheel ---- */
  .wheel {
    position: absolute; top: 50%; right: calc(var(--D) / -2);
    width: var(--D); height: var(--D); margin-top: calc(var(--D) / -2);
    transform: rotate(var(--rot, 0deg));
    will-change: transform;
  }
  .ring {
    position: absolute; inset: calc((var(--D) - 2 * var(--R)) / 2);
    border-radius: 50%; border: 1px dashed rgba(246, 238, 220, .28);
  }
  .hub {
    position: absolute; inset: 0; margin: auto;
    width: calc(var(--R) * .8); height: calc(var(--R) * .8); border-radius: 50%;
    background:
      radial-gradient(circle, var(--wdeep) 0 16%, transparent 17%),
      repeating-conic-gradient(rgba(246, 238, 220, .12) 0 6deg, transparent 6deg 36deg);
    border: 1px solid rgba(246, 238, 220, .24);
  }
  .frame { position: absolute; inset: 0; transform: rotate(var(--a)); }
  .slide {
    position: absolute; top: 50%; left: calc(50% - var(--R));
    width: var(--sw); aspect-ratio: 4 / 3; transform: translate(-50%, -50%);
    border-radius: 12px; overflow: hidden;
    background: linear-gradient(135deg, var(--wface), color-mix(in srgb, var(--wbg) 90%, #fff));
    border: 1px solid rgba(246, 238, 220, .3);
    color: var(--wcream);
    box-shadow: 0 14px 24px -16px rgba(6, 18, 60, .7);
    display: flex; align-items: flex-end; padding: .9rem 1rem;
    font: 700 1.05rem/1.2 var(--font-display, inherit);
    opacity: .5; transition: opacity .4s, border-color .4s, box-shadow .4s;
  }
  .slide b { display: block; font-size: 1.8rem; line-height: 1; margin-bottom: .3rem; color: var(--wsun); }
  .slide.on { opacity: 1; border-color: var(--wsun); box-shadow: 0 0 0 4px rgba(233, 185, 73, .22), 0 18px 30px -16px rgba(6, 18, 60, .8); }
  .slide.empty { background: none; border-style: dashed; box-shadow: none; opacity: .28; }

  /* ---- mobile ---- */
  @media (max-width: 860px) {
    .stage {
      --D: 170vw; --R: 64vw; --sw: 44vw;
      grid-template-columns: 1fr; align-items: start; padding-top: 5rem;
    }
    .copy h2 { font-size: 1.5rem; margin-bottom: .6rem; }
    .panel h3 { font-size: 1.2rem; margin-bottom: .5rem; }
    .panel .body { font-size: .84rem; line-height: 1.55; margin-bottom: .5rem; }
    .wheel { top: 90%; }
  }

  /* Short and narrow viewports, reduced motion and no-JS get readable stacked content. */
  .story--stacked { height: auto; }
  .story--stacked .stage { position: static; height: auto; padding-block: 3rem; grid-template-columns: minmax(0, 1fr); overflow: visible; }
  .story--stacked .wheel { display: none; }
  .story--stacked .panels { gap: 2.4rem; }
  .story--stacked .panel { grid-area: auto; opacity: 1; transform: none; transition: none; pointer-events: auto; }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('.story');
  const stacked = matchMedia('(prefers-reduced-motion: reduce), (max-width: 360px), (max-height: 680px)');

  if (sec) {
    const wheel = sec.querySelector<HTMLElement>('.wheel')!;
    const slides = [...sec.querySelectorAll<HTMLElement>('.slide[data-i]')];
    const panels = [...sec.querySelectorAll<HTMLElement>('.panel')];
    const n = Number(sec.dataset.count);
    const step = Number(sec.dataset.step);

    let target = 0;   // where scroll says the wheel should be (0 … n-1)
    let current = 0;  // eased value that actually drives the rotation
    let running = false;

    const readScroll = () => {
      if (stacked.matches) return;
      const total = sec.offsetHeight - innerHeight;
      if (total <= 0) return;
      const p = Math.min(1, Math.max(0, -sec.getBoundingClientRect().top / total));
      // first 10% and last 10% of the scroll hold on the first/last slide
      const eased = Math.min(1, Math.max(0, (p - 0.1) / 0.8));
      target = eased * (n - 1);
      if (!running) { running = true; requestAnimationFrame(tick); }
    };

    const tick = () => {
      if (stacked.matches) { running = false; return; }
      current += (target - current) * 0.1;          // lower = floatier
      if (Math.abs(target - current) < 0.001) current = target;
      wheel.style.setProperty('--rot', `${current * step}deg`);

      const active = Math.round(current);
      slides.forEach((el) => el.classList.toggle('on', Number(el.dataset.i) === active));
      panels.forEach((el, i) => {
        el.classList.toggle('on', i === active);
        el.setAttribute('aria-hidden', i === active ? 'false' : 'true');
      });

      if (current !== target) requestAnimationFrame(tick);
      else running = false;
    };

    addEventListener('scroll', readScroll, { passive: true });
    addEventListener('resize', readScroll);
    const syncMode = () => {
      sec.classList.toggle('story--stacked', stacked.matches);
      if (stacked.matches) panels.forEach(el => el.removeAttribute('aria-hidden'));
      else readScroll();
    };
    stacked.addEventListener('change', syncMode);
    syncMode();
  }
</script>

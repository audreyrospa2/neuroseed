---
// One partner-organisation section. Used for both Brown Rice and Ecorazón;
// `flip` mirrors the layout so the two sections don't look identical.
interface Props {
  id: string;
  c: { tag: string; h: string; lead: string; points: { h: string; p: string }[] };
  flip?: boolean;
  tint?: boolean;
  tone?: 'a' | 'b';
  img?: string;          // real photo path, replaces the placeholder
}
const { id, c, flip = false, tint = false, tone = 'a', img = '' } = Astro.props;
---
<section class={`org section${tint ? ' section--tint' : ''}`} id={id}>
  <div class={`container org-grid${flip ? ' flip' : ''}`}>
    <div class={`org-media tone-${tone}`}>
      {img
        ? <img src={img} alt="" loading="lazy" />
        : <span class="ph" aria-hidden="true">PHOTO</span>}
      <span class="org-tag">{c.tag}</span>
    </div>

    <div class="org-body">
      <h2>{c.h}</h2>
      <p class="lead">{c.lead}</p>
      <dl class="org-points">
        {c.points.map((p) => (
          <div>
            <dt>{p.h}</dt>
            <dd>{p.p}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .org-grid {
    display: grid; grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center;
  }
  .flip .org-media { order: 2; }

  .org-media {
    --b: var(--brand, #2F52A8);
    position: relative; aspect-ratio: 5 / 4; overflow: hidden;
    border-radius: var(--radius-lg, 28px);
    box-shadow: 0 24px 40px -26px rgba(20, 40, 100, .6);
  }
  .tone-a { background: var(--b); }
  .tone-b { background: color-mix(in srgb, var(--b) 62%, #fff); }
  .org-media img, .ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph {
    display: grid; place-items: center; color: #fff; opacity: .7;
    font: 700 .75rem/1 var(--font-display, inherit); letter-spacing: .2em;
    background: repeating-linear-gradient(45deg, rgba(255, 255, 255, .12) 0 10px, transparent 10px 20px);
  }
  /* file-label tab, echoing the folder in the hero */
  .org-tag {
    position: absolute; left: 1.2rem; bottom: 1.2rem;
    background: #F6EEDC; color: #3A2C14;
    padding: .55rem 1rem; border-radius: 6px; transform: rotate(-2deg);
    font: 700 .95rem/1 var(--font-display, inherit);
    box-shadow: 0 6px 12px -6px rgba(0, 0, 0, .45);
  }

  .org-body h2 { margin: 0 0 .8rem; }
  .org-body .lead { margin: 0 0 1.8rem; max-width: 48ch; }
  .org-points { margin: 0; display: grid; gap: 1.2rem; }
  .org-points > div { padding-left: 1.1rem; border-left: 3px solid var(--sun, #E9B949); }
  dt { font: 700 1.1rem/1.3 var(--font-display, inherit); margin-bottom: .2rem; }
  dd { margin: 0; color: var(--muted, #555); line-height: 1.7; max-width: 52ch; }

  @media (max-width: 860px) {
    .org-grid { grid-template-columns: 1fr; }
    .flip .org-media { order: 0; }
  }
</style>
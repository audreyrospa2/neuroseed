---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Photo from '../../components/Photo.astro';
import Partners from '../../components/Partners.astro';
import { t, type Lang } from '../../i18n/utils';
import impact from '../../content/pages/impact.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = impact[lang];

// stats: count up only when the value is a real number (placeholders like "XX" stay as text)
const stats = c.research.stats.map((s) => ({ ...s, count: /^\d+$/.test(String(s.value)) ? s.value : null }));

// orbit: three nested circles, all tangent at the top-right point T (like the reference)
const orbitItems = c.research.orbit.items;
const U = Math.SQRT1_2;
const circles = [100, 84, 52].map((d) => {
  const r = d / 2, off = (50 - r) * U;
  const left = 50 + off - r, top = 50 - off - r;
  return { d, left: left.toFixed(2), top: top.toFixed(2),
    ox: (((50 + 50 * U) - left) / d * 100).toFixed(1), oy: (((50 - 50 * U) - top) / d * 100).toFixed(1) };
});
const spots = [
  { x: 85.4, y: 14.6, side: 'left' },   // 1: on the tangent point
  { x: 72, y: 38, side: 'left' },       // 2: inside the smallest circle
  { x: 4.7, y: 71.1, side: 'right' },   // 3: on the outer ring
  { x: 48.4, y: 85.7, side: 'right' }   // 4: bottom of the middle circle
];
const nodes = orbitItems.map((o, i) => ({ ...o, ...spots[i % spots.length] }));

const tilts = [-2.4, 1.8, -1.4, 2.2];
const drops = [0.4, 1.8, 0.9, 2.2]; // rem: how far each card hangs
---
<Layout lang={lang} title={t(lang, 'nav.impact')} description={c.lead}>
  <PageHead eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

  <!-- 1. RESEARCH DATA -->
  <section class="section section--tint">
    <div class="container">
      <header class="head rv">
        <p class="kicker">{c.research.kicker}</p>
        <h2>{c.research.h}</h2>
        <p class="lead">{c.research.lead}</p>
      </header>

      <div class="data">
        <div class="card rv" data-stats>
          <div class="card__top">
            <span class="card__dot" aria-hidden="true"></span>
            <p><strong>{c.research.partner}</strong><small>{c.research.partnerSub}</small></p>
          </div>
          <div class="stats">
            {stats.map((s, i) => (
              <div class="stat" style={`--i:${i}`}>
                <p class="stat__n"><span data-count={s.count}>{s.value}</span><span class="stat__suffix">{s.suffix}</span></p>
                <p class="stat__label">{s.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="orbitwrap rv" style="--d:120ms" data-orbit>
          <div class="orbit">
            {circles.map((ci) => (
              <span class="orbit__circle" aria-hidden="true"
                style={`width:${ci.d}%; height:${ci.d}%; left:${ci.left}%; top:${ci.top}%; --ox:${ci.ox}%; --oy:${ci.oy}%`}></span>
            ))}
            <p class="orbit__label">{c.research.orbit.h}</p>
            {nodes.map((o, i) => (
              <button type="button" class={`orbit__node orbit__node--${o.side}${i === 0 ? ' on' : ''}`} style={`left:${o.x}%; top:${o.y}%`}
                aria-pressed={i === 0 ? 'true' : 'false'} aria-label={o.h} data-h={o.h} data-p={o.p}>
                <i></i><em>{o.h}</em>
              </button>
            ))}
          </div>
          <div class="orbitwrap__cap" aria-live="polite">
            <small data-n>1 / {nodes.length}</small>
            <strong data-h>{nodes[0].h}</strong>
            <p data-p>{nodes[0].p}</p>
          </div>
          <p class="orbitwrap__hint">{c.research.orbit.hint}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. MESSAGE + VOICES -->
  <section class="section">
    <div class="container">
      <article class="msg rv">
        <div class="msg__photo"><Photo label={c.message.name} src={c.message.img} color="#2F6FD0" icon="💬" ratio="1 / 1" /></div>
        <div class="msg__body">
          <p class="kicker">{c.message.kicker}</p>
          <h2>{c.message.h}</h2>
          <blockquote>{c.message.quote}</blockquote>
          <p class="msg__who"><strong>{c.message.name}</strong><span>{c.message.role}</span></p>
        </div>
      </article>

      <h3 class="voices__h rv">{c.voices.h}</h3>
      <div class="voices">
        {c.voices.items.map((v, i) => (
          <figure class="voice rv" style={`--d:${i * 110}ms`}>
            <div class="voice__av"><Photo label={v.who} src={v.img} color="#2F6FD0" icon="🙂" ratio="1 / 1" /></div>
            <blockquote>{v.quote}</blockquote>
            <figcaption>{v.who}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. JOB OPPORTUNITY -->
  <section class="section section--deep jobs">
    <div class="container">
      <header class="head head--light rv">
        <p class="kicker kicker--sun">{c.jobs.kicker}</p>
        <h2>{c.jobs.h}</h2>
        <p class="lead">{c.jobs.lead}</p>
      </header>

      <article class="bridge rv">
        <span class="bridge__icon" aria-hidden="true">{c.jobs.bridge.icon}</span>
        <div>
          <h3>{c.jobs.bridge.h}</h3>
          <p class="bridge__sub">{c.jobs.bridge.sub}</p>
          <p class="bridge__p">{c.jobs.bridge.p}</p>
        </div>
      </article>

      <header class="rp__head rv">
        <h3>{c.jobs.roleplay.h}</h3>
        <p>{c.jobs.roleplay.sub}</p>
      </header>

      <div class="hang" data-hang>
        {c.jobs.roleplay.items.map((p, i) => (
          <div class="slot" style={`--drop:${drops[i % 4]}rem; --tilt:${tilts[i % 4]}deg; --d:${i * 140}ms`}>
            <span class="slot__thread" aria-hidden="true"></span>
            <div class="flip" role="button" tabindex="0" aria-pressed="false" aria-label={`${p.name} – ${p.role}`}>
              <span class="flip__pin" aria-hidden="true"></span>
              <div class="flip__inner">
                <div class="flip__face flip__front">
                  <div class="flip__photo"><Photo label={p.name} src={p.img} color="#2F6FD0" icon="🎭" ratio="1 / 1" /></div>
                  <strong>{p.name}</strong>
                  <small>{p.role}</small>
                  <span class="flip__tap" aria-hidden="true">↻</span>
                </div>
                <div class="flip__face flip__back">
                  <span class="flip__q" aria-hidden="true">“</span>
                  <blockquote>{p.quote}</blockquote>
                  <small>{p.name} · {p.role}</small>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="hang__hint rv">↻ {c.jobs.roleplay.hint}</p>
    </div>
  </section>

  <!-- 4. CTA -->
  <section class="section section--grad cta">
    <div class="container">
      <h2>{c.cta.h}</h2>
      <p class="cta__p">{c.cta.p}</p>
      <div class="cta__row">
        <a class="btn btn--sun" href={`/${lang}/book-a-training/`}>{t(lang, 'cta.book')}</a>
        <a class="cta__mail" href={`mailto:${c.cta.email}`}>{c.cta.email}</a>
      </div>
    </div>
  </section>

  <Partners lang={lang} />
</Layout>

<style>
  .head { text-align: center; max-width: 46rem; margin: 0 auto 3rem; }
  .head h2 { text-wrap: balance; }
  .head .lead { margin: 1rem auto 0; text-wrap: pretty; }
  .kicker { font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: var(--fs-sm); margin-bottom: 0.7rem; color: var(--brand); }
  .kicker--sun { color: var(--sun); }
  .head--light h2, .head--light .lead { color: #fff; }
  .head--light .lead { opacity: 0.9; }

  /* scroll reveal (only active once JS runs) */
  :global(.rv-on) .rv { opacity: 0; transform: translateY(26px); transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms); }
  :global(.rv-on) .rv.in { opacity: 1; transform: none; }

  /* ---- 1 Research data ---- */
  .data { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }

  .card { background: #fff; border-radius: var(--radius-lg); box-shadow: 0 18px 44px rgba(30, 79, 163, 0.12); overflow: hidden; }
  .card__top { display: flex; align-items: center; gap: 0.9rem; padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--line); }
  .card__top p { margin: 0; display: grid; gap: 0.1rem; }
  .card__top strong { color: var(--brand-deep); }
  .card__top small { color: var(--muted); }
  .card__dot { width: 12px; height: 12px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 5px color-mix(in srgb, var(--brand) 18%, transparent); }

  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); }
  .stat { position: relative; background: #fff; padding: 1.8rem 1.6rem 1.6rem; transition: background 0.3s; }
  .stat:hover { background: color-mix(in srgb, var(--brand) 5%, #fff); }
  .stat::after { content: ''; position: absolute; left: 1.6rem; right: 1.6rem; bottom: 0; height: 3px; border-radius: 3px; background: var(--brand);
    transform: scaleX(0); transform-origin: left; transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) calc(0.3s + var(--i) * 0.12s); }
  :global(.rv-on) .card.in .stat::after, .card:not(.rv) .stat::after { transform: scaleX(1); }
  :global(html:not(.rv-on)) .stat::after { transform: scaleX(1); }
  .stat__n { margin: 0; display: flex; align-items: baseline; gap: 0.1em; font: 700 clamp(2.6rem, 5.4vw, 3.8rem) / 1 var(--font-body); letter-spacing: -0.04em; color: var(--brand-deep); font-variant-numeric: tabular-nums; }
  .stat__suffix { font-size: 0.6em; letter-spacing: 0; color: var(--brand); }
  .stat__label { margin: 0.8rem 0 0; color: var(--muted); font-size: var(--fs-sm); line-height: 1.45; text-wrap: balance; }

  .orbitwrap { display: grid; justify-items: center; gap: 1.4rem; width: 100%; }
  .orbit { position: relative; width: 100%; max-width: 480px; aspect-ratio: 1; }
  .orbit__circle { position: absolute; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--brand) 16%, #fff);
    transform-origin: var(--ox) var(--oy); animation: breathe 7s ease-in-out infinite;
    box-shadow: inset -12px 14px 34px rgba(30, 79, 163, 0.07); }
  .orbit__circle:nth-of-type(1) { background: color-mix(in srgb, var(--brand) 7%, #fff); }
  .orbit__circle:nth-of-type(2) { background: color-mix(in srgb, var(--brand) 3.5%, #fff); animation-delay: -2.4s; }
  .orbit__circle:nth-of-type(3) { background: #fff; animation-delay: -4.8s; }
  @keyframes breathe { 50% { transform: scale(1.016); } }
  .orbit__label { position: absolute; left: 0; top: 0; z-index: 1; margin: 0; max-width: 23%; font-size: 0.8rem; font-weight: 700; line-height: 1.35; color: var(--brand-deep); text-wrap: balance; }

  .orbit__node { position: absolute; z-index: 2; translate: -50% -50%; width: 12px; height: 12px; padding: 0; border: 0; background: none; cursor: pointer; }
  .orbit__node::before { content: ''; position: absolute; inset: -16px; border-radius: 50%; }
  .orbit__node i { display: block; width: 100%; height: 100%; border-radius: 50%; background: var(--brand); transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s; }
  .orbit__node em { position: absolute; top: 50%; translate: 0 -50%; width: max-content; max-width: 8.5rem; font-style: normal; font-size: 0.8rem; line-height: 1.3; color: var(--muted); transition: color 0.25s, font-weight 0.25s; }
  .orbit__node--right em { left: calc(100% + 16px); text-align: left; }
  .orbit__node--left em { right: calc(100% + 16px); text-align: right; }
  .orbit__node:hover i { transform: scale(1.5); }
  .orbit__node:hover em, .orbit__node.on em { color: var(--brand-deep); font-weight: 700; }
  .orbit__node:focus-visible i { outline: 3px solid var(--sun); outline-offset: 3px; }
  .orbit__node.on i { transform: scale(1.75); box-shadow: 0 0 0 6px color-mix(in srgb, var(--brand) 22%, transparent); animation: ping 2.4s ease-in-out infinite; }
  @keyframes ping { 50% { box-shadow: 0 0 0 12px color-mix(in srgb, var(--brand) 6%, transparent); } }

  .orbitwrap__cap { display: grid; justify-items: center; gap: 0.3rem; text-align: center; min-height: 7.4rem; max-width: 30rem; }
  .orbitwrap__cap small { font-weight: 700; letter-spacing: 0.14em; color: var(--brand); font-size: 0.75rem; }
  .orbitwrap__cap strong { font: 700 1.4rem / 1.2 var(--font-display); color: var(--brand-deep); }
  .orbitwrap__cap p { margin: 0; color: var(--muted); text-wrap: balance; }
  .orbitwrap__cap.swap > * { animation: coreIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .orbitwrap__cap.swap > :nth-child(2) { animation-delay: 0.05s; }
  .orbitwrap__cap.swap > :nth-child(3) { animation-delay: 0.1s; }
  @keyframes coreIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .orbitwrap__hint { margin: -0.4rem 0 0; font-size: var(--fs-sm); color: var(--muted); opacity: 0.85; }

  /* ---- 2 Message + voices ---- */
  .msg { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 300px) 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center;
    background: linear-gradient(135deg, var(--tint), #fff 85%); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.6rem, 4vw, 3rem); }
  .msg::after { content: '“'; position: absolute; right: 2.4rem; top: -2rem; font: 700 16rem / 1 var(--font-display); color: var(--brand); opacity: 0.07; pointer-events: none; }
  .msg__photo { position: relative; border-radius: 50%; overflow: hidden; outline: 8px solid #fff; box-shadow: 0 18px 40px rgba(30, 79, 163, 0.22); }
  .msg__body { position: relative; z-index: 1; }
  .msg h2 { color: var(--brand-deep); margin: 0 0 1.2rem; text-wrap: balance; }
  .msg blockquote { margin: 0 0 1.6rem; font: 400 clamp(1.25rem, 2.3vw, 1.75rem) / 1.5 var(--font-display); color: var(--brand-deep); text-wrap: pretty; max-width: 34ch; }
  .msg__who { margin: 0; display: flex; align-items: center; gap: 0.9rem; color: var(--muted); }
  .msg__who::before { content: ''; width: 2.4rem; height: 3px; border-radius: 3px; background: var(--sun); }
  .msg__who strong { color: var(--brand-deep); }

  .voices__h { text-align: center; color: var(--brand-deep); margin: 3.6rem 0 0.4rem; }
  .voices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; padding-top: 3.6rem; }
  .voice { position: relative; margin: 0; display: grid; grid-template-rows: 1fr auto; align-items: center; justify-items: center; gap: 1rem; text-align: center;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 3.4rem 1.4rem 1.5rem; min-height: 12rem;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s, border-color 0.3s; }
  .voice:hover { transform: translateY(-8px); box-shadow: 0 18px 38px rgba(30, 79, 163, 0.16); border-color: var(--brand); }
  .voice__av { position: absolute; top: -44px; left: 50%; translate: -50% 0; width: 88px; border-radius: 50%; overflow: hidden; outline: 5px solid #fff; box-shadow: 0 8px 20px rgba(30, 79, 163, 0.2); transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .voice:hover .voice__av { transform: scale(1.08) rotate(-4deg); }
  .voice blockquote { margin: 0; color: var(--brand-deep); font: 700 1.1rem / 1.45 var(--font-body); text-wrap: balance; }
  .voice figcaption { color: var(--muted); font-size: var(--fs-sm); padding-top: 0.8rem; border-top: 1px solid var(--line); width: 60%; }

  /* ---- 3 Jobs ---- */
  .bridge { display: grid; grid-template-columns: auto 1fr; gap: 1.8rem; align-items: center; max-width: 54rem; margin: 0 auto 4.4rem;
    background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.22); border-radius: var(--radius-lg); padding: 2rem 2.2rem; backdrop-filter: blur(4px); }
  .bridge__icon { display: grid; place-items: center; width: 88px; height: 88px; border-radius: 50%; background: var(--sun); font-size: 2.7rem; animation: bob 4s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-6px) rotate(-4deg); } }
  .bridge h3 { color: #fff; margin: 0; }
  .bridge__sub { color: var(--sun); font-weight: 700; margin: 0.2rem 0 0.8rem; }
  .bridge__p { margin: 0; color: rgba(255, 255, 255, 0.92); text-wrap: pretty; }

  .rp__head { text-align: center; margin-bottom: 2.4rem; }
  .rp__head h3 { color: #fff; margin: 0; }
  .rp__head p { margin: 0.3rem 0 0; color: var(--sun); font-weight: 700; }

  /* hanging cards: string -> thread -> pin -> card swinging from the pin */
  .hang { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; padding: 0 0.8rem; max-width: 62rem; margin-inline: auto; }  .slot { position: relative; padding-top: calc(1.8rem + var(--drop)); }
  .slot::before { content: ''; position: absolute; top: 0; left: -0.8rem; right: -0.8rem; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.5); }
  .slot__thread { position: absolute; top: 0; left: 50%; width: 2px; height: calc(1.8rem + var(--drop)); translate: -50% 0; background: rgba(255, 255, 255, 0.6); }

  .flip { position: relative; perspective: 1100px; cursor: pointer; transform-origin: 50% 0; rotate: var(--tilt); transition: rotate 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); outline: none; }
  .flip__pin { position: absolute; z-index: 3; left: 50%; top: -7px; translate: -50% 0; width: 14px; height: 14px; border-radius: 50%; background: var(--sun); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.35), 0 2px 6px rgba(0, 0, 0, 0.3); }
  .flip:hover { animation: sway 2.6s ease-in-out infinite; }
  .flip[aria-pressed='true']:hover { animation: none; rotate: 0deg; }
  @keyframes sway { 0%, 100% { rotate: calc(var(--tilt) * 0.2); } 50% { rotate: calc(var(--tilt) * -0.7); } }
  .flip:focus-visible .flip__inner { box-shadow: 0 0 0 4px var(--sun), 0 16px 34px rgba(0, 0, 0, 0.35); }

  .flip__inner { position: relative; transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); border-radius: var(--radius-md); box-shadow: 0 18px 36px rgba(0, 0, 0, 0.32); }
  .flip[aria-pressed='true'] .flip__inner { transform: rotateY(180deg); }
  .flip__face { backface-visibility: hidden; -webkit-backface-visibility: hidden; background: #fff; border-radius: var(--radius-md); padding: 0.8rem 0.8rem 1.1rem; color: var(--brand-deep); }
  .flip__front { position: relative; display: grid; gap: 0.1rem; }
  .flip__photo { border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 0.7rem; }
  .flip__front strong { font-size: 1.1rem; padding: 0 0.3rem; }
  .flip__front small, .flip__back small { color: var(--muted); padding: 0 0.3rem; }
  .flip__tap { position: absolute; right: 0.9rem; bottom: 0.8rem; width: 1.9rem; height: 1.9rem; display: grid; place-items: center; border-radius: 50%; background: var(--tint); color: var(--brand); font-size: 1.1rem; transition: transform 0.5s; }
  .flip:hover .flip__tap { transform: rotate(180deg); }
  /* cursor-following gradient rim + glow on the front */
  .flip__front::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 3px; pointer-events: none; opacity: 0; transition: opacity 0.35s;
    background: radial-gradient(200px circle at var(--mx, 50%) var(--my, 50%), var(--sun), #ff9ec4 42%, var(--brand) 78%, transparent);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
  .flip__front::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity 0.35s;
    background:
      radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.5), transparent 62%),
      radial-gradient(340px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--sun) 32%, transparent), color-mix(in srgb, var(--brand) 18%, transparent) 48%, transparent 78%); }
  .flip:hover .flip__front::before, .flip:hover .flip__front::after { opacity: 1; }
  .flip:hover .flip__inner { box-shadow: 0 24px 46px rgba(0, 0, 0, 0.4); }

  /* back: brushed metal, with a specular streak and glow that follow the cursor */
  .flip__back { position: absolute; inset: 0; overflow: hidden; transform: rotateY(180deg); display: grid; align-content: center; justify-items: center; gap: 0.6rem; text-align: center; padding: 1.4rem 1.2rem; color: #18213a;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.12) 0 1px, rgba(0, 0, 0, 0.035) 1px 3px),
      linear-gradient(125deg, #c9d1de 0%, #f8fafd 16%, #9aa7bc 32%, #eef2f8 48%, #8795ad 64%, #e8ecf5 80%, #a9b4c8 100%);
    background-size: auto, 260% 260%;
    animation: metal 9s ease-in-out infinite;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.75), inset 0 -20px 34px rgba(60, 75, 100, 0.2); }
  @keyframes metal { 0%, 100% { background-position: 0 0, 0% 25%; } 50% { background-position: 0 0, 100% 75%; } }
  .flip__back::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 0.35s;
    background: linear-gradient(105deg, transparent calc(var(--sx, 50%) - 16%), rgba(255, 255, 255, 0.85) var(--sx, 50%), transparent calc(var(--sx, 50%) + 16%)); }
  .flip__back::after { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 0.35s;
    background: radial-gradient(240px circle at var(--bx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.65), rgba(150, 185, 255, 0.28) 45%, transparent 72%); }
  .flip:hover .flip__back::before, .flip:hover .flip__back::after { opacity: 1; }
  .flip__back > * { position: relative; z-index: 1; }
  .flip__q { font: 700 3.4rem / 0.6 var(--font-display); color: rgba(24, 33, 58, 0.3); }
  .flip__back blockquote { margin: 0; font-weight: 700; line-height: 1.5; text-wrap: balance; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7); }
  .flip__back small { color: #3a4560; }

  /* cards swing in when the row scrolls into view */
  :global(.rv-on) .hang .flip { opacity: 0; }
  :global(.rv-on) .hang.in .flip { opacity: 1; animation: swingIn 1.9s cubic-bezier(0.22, 1, 0.36, 1) var(--d) backwards; }
  @keyframes swingIn {
    0% { opacity: 0; rotate: 22deg; translate: 0 -14px; }
    12% { opacity: 1; }
    38% { rotate: -9deg; translate: 0 0; }
    62% { rotate: 5deg; }
    82% { rotate: calc(var(--tilt) - 1deg); }
    100% { rotate: var(--tilt); }
  }
  .hang__hint { text-align: center; margin: 3rem 0 0; color: rgba(255, 255, 255, 0.78); font-size: var(--fs-sm); }

  /* ---- 4 CTA ---- */
  .cta .container { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.4rem; }
  .cta h2 { max-width: 20ch; text-wrap: balance; }
  .cta__p { max-width: 36rem; margin: 0; font-size: var(--fs-lg); color: rgba(255, 255, 255, 0.9); }
  .cta__row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1.4rem; }
  .cta__mail { color: #fff; font-weight: 700; font-size: var(--fs-lg); }

  @media (max-width: 1000px) {
    .hang { grid-template-columns: repeat(2, 1fr); row-gap: 1.4rem; }
    }
  @media (max-width: 880px) {
    .data { grid-template-columns: 1fr; }
    .msg { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .msg__photo { width: min(62%, 260px); }
    .msg blockquote { margin-inline: auto; }
    .msg__who { flex-direction: column; align-items: center; gap: 0.35rem; }
    .msg__who::before { margin-bottom: 0.4rem; }
    .voices { grid-template-columns: 1fr; row-gap: 4.2rem; max-width: 26rem; margin: 0 auto; }
  }
    @media (max-width: 760px) {
    .hang { grid-template-columns: 1fr; max-width: 270px; margin: 0 auto; row-gap: 1.4rem; }
  }
  @media (max-width: 560px) {
    .bridge { grid-template-columns: 1fr; justify-items: center; text-align: center; padding: 1.6rem; }
    .stat { padding: 1.4rem 1rem 1.2rem; }
    .stat::after { left: 1rem; right: 1rem; }
    .orbit__node em { font-size: 0.7rem; max-width: 6rem; }
    .orbit__label { font-size: 0.72rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit__circle, .orbit__node.on i, .bridge__icon, .flip:hover, .flip__back { animation: none; }
    .flip__inner, .flip, .voice, .stat::after { transition: none; }

<script>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Scroll reveal + hanging-card entrance */
    if ('IntersectionObserver' in window && !reduce) {
      document.documentElement.classList.add('rv-on');
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rv, [data-hang]').forEach(function (el) { io.observe(el); });
    }

    /* Count-up for numeric stats ("XX" placeholders are left alone) */
    function run(el) {
      var to = parseInt(el.getAttribute('data-count'), 10);
      if (isNaN(to) || reduce) return;
      var t0 = null, dur = 1500;
      function tick(ts) {
        if (!t0) t0 = ts;
        var p = Math.min(1, (ts - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(to * e).toLocaleString();
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    var nums = Array.prototype.filter.call(document.querySelectorAll('[data-count]'), function (n) { return n.getAttribute('data-count'); });
    if ('IntersectionObserver' in window) {
      var co = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { run(e.target); co.unobserve(e.target); } });
      }, { threshold: 0.6 });
      nums.forEach(function (n) { co.observe(n); });
    }

    /* Orbit: click a node, or let it cycle through the steps on its own */
    document.querySelectorAll('[data-orbit]').forEach(function (root) {
      var nodes = root.querySelectorAll('.orbit__node'), cap = root.querySelector('.orbitwrap__cap');
      var nEl = cap.querySelector('[data-n]'), hEl = cap.querySelector('[data-h]'), pEl = cap.querySelector('[data-p]');
      var cur = 0, hold = false, resume;
      function set(i) {
        cur = i;
        nodes.forEach(function (n, j) { n.classList.toggle('on', j === i); n.setAttribute('aria-pressed', j === i ? 'true' : 'false'); });
        nEl.textContent = (i + 1) + ' / ' + nodes.length;
        hEl.textContent = nodes[i].dataset.h;
        pEl.textContent = nodes[i].dataset.p;
        cap.classList.remove('swap'); void cap.offsetWidth; cap.classList.add('swap');
      }
      nodes.forEach(function (n, i) {
        n.addEventListener('click', function () {
          set(i); hold = true; clearTimeout(resume); resume = setTimeout(function () { hold = false; }, 9000);
        });
      });
      ['mouseenter', 'focusin'].forEach(function (e) { root.addEventListener(e, function () { hold = true; }); });
      ['mouseleave', 'focusout'].forEach(function (e) { root.addEventListener(e, function () { clearTimeout(resume); hold = false; }); });
      if (!reduce) setInterval(function () { if (!hold && !document.hidden) set((cur + 1) % nodes.length); }, 3600);
    });

    /* Flip cards: click / Enter / Space */
    document.querySelectorAll('.flip').forEach(function (card) {
      /* cursor position drives the gradient rim, glow and metallic streak */
      card.addEventListener('pointermove', function (e) {
        var r = card.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
        card.style.setProperty('--mx', x + 'px');
        card.style.setProperty('--my', y + 'px');
        card.style.setProperty('--bx', (r.width - x) + 'px');                 /* back face is mirrored */
        card.style.setProperty('--sx', ((1 - x / r.width) * 100) + '%');
      });
      function toggle() { card.setAttribute('aria-pressed', card.getAttribute('aria-pressed') === 'true' ? 'false' : 'true'); }
      card.addEventListener('click', toggle);
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
    });
  })();
</script>
---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Partners from '../../components/Partners.astro';
import { t, type Lang } from '../../i18n/utils';
import news from '../../content/pages/news.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = news[lang];
const locale = lang === 'zh' ? 'zh-HK' : 'en-GB';

const items = [...c.items]
  .sort((a, b) => b.date.localeCompare(a.date))
  .map((n) => ({
    ...n,
    meta: (n as { meta?: { k: string; v: string }[] }).meta ?? [],
    dateLabel: new Date(n.date + 'T00:00:00').toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' }),
    dot: n.date.replaceAll('-', '.'),
    catLabel: c.cats[n.cat as 'expo']
  }));
const featured = items[0];
const count = (k: string) => (k === 'all' ? items.length : items.filter((n) => n.cat === k).length);
const filters = (['all', 'expo'] as const).map((k) => ({ k, label: c.filters[k], n: count(k) }));
const multi = items.length > 1;
---
<Layout lang={lang} title={t(lang, 'nav.news')} description={c.lead}>

  <!-- HERO: newspaper corridor, big headline, vertical + horizontal wordmark, pick-up card
  <header class="hero" data-hero>
    <div class="hero__tunnel" aria-hidden="true">
      <div class="paper paper--l"></div>
      <div class="paper paper--r"></div>
      <div class="paper paper--t"></div>
      <div class="paper paper--b"></div>
      <span class="shard shard--a"></span>
      <span class="shard shard--b"></span>
      <span class="shard shard--c"></span>
      <span class="shard shard--d"></span>
      <div class="hero__fog"></div>
    </div>

    <div class="hero__brand" aria-hidden="true">
      <span class="hero__v">{c.hero.brandV}</span>
      <span class="hero__h">{c.hero.brandH}</span>
    </div>

    <div class="hero__copy">
      <p class="hero__eyebrow">{c.eyebrow}</p>
      <h1 class="hero__title"><span>{c.hero.l1}</span><span>{c.hero.l2}</span></h1>
      <p class="hero__lead">{c.lead}</p>
    </div>

    <a class="pick" href="#news-list" data-pick={featured.id}>
      <div class="pick__bar">
        <span>{c.hero.pick} <i>|</i> {featured.dot}</span>
        <span>BRAINY IN-CHARGE</span>
      </div>
      <div class="pick__body">
        <div class="pick__img"><Photo label={featured.title} src={featured.img} color="#2F6FD0" icon="📰" ratio="4 / 3" /></div>
        <div class="pick__txt">
          <strong>{featured.title}</strong>
          <small>{featured.catLabel}</small>
          <p>{featured.excerpt}</p>
        </div>
      </div>
    </a>
  </header> -->

  <!-- NEWS: preview on the left, list on the right -->
  <section class="section news" id="news-list">
    <div class="container">
      <header class="news__head rv">
        <div>
          <h2>{c.list.h}</h2>
          <p class="news__hint">{c.list.hint}</p>
        </div>
        <div class="filters" role="group" aria-label={c.list.h}>
          {filters.map((f, i) => (
            <button type="button" class="filters__btn" data-filter={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}<b>{f.n}</b>
            </button>
          ))}
        </div>
      </header>

      <div class="news__grid">
      <!-- LEFT: preview -->
      <div class="preview rv" data-preview>
        {items.map((n, i) => (
          <article class="pv" id={`pv-${n.id}`} data-id={n.id} role="tabpanel" aria-labelledby={`li-${n.id}`} hidden={i !== 0}>
            <div class="pv__cover">
              {n.poster ? (
                <img class="pv__poster" src={n.img} alt={n.alt} loading="lazy" />
              ) : (
                <Photo label={n.title} src={n.img} color="#2F6FD0" icon="📰" ratio="16 / 9" />
              )}
              <span class={`chip chip--${n.cat}`}>{n.catLabel}</span>
            </div>

            <div class="pv__body">
              <time datetime={n.date}>{n.dateLabel}</time>
              <h3>{n.title}</h3>

              {n.body.map((p) => <p>{p}</p>)}

              {n.meta && n.meta.length > 0 && (
                <dl class="pv__meta">
                  {n.meta.map((m) => (
                    <div><dt>{m.k}</dt><dd>{m.v}</dd></div>
                  ))}
                </dl>
              )}

              {(multi || n.cat === 'invite') && (
                <div class="pv__foot">
                  {n.cat === 'invite' && (
                    <a class="btn btn--sun" href={`mailto:${c.cta.email}?subject=${encodeURIComponent(n.title)}`}>{c.list.rsvp}</a>
                  )}
                  {multi && (
                    <div class="pv__nav">
                      <button type="button" data-step="-1" aria-label={c.list.prev}>‹</button>
                      <span data-pos>1 / {items.length}</span>
                      <button type="button" data-step="1" aria-label={c.list.next}>›</button>
                    </div>
                  )}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

        <!-- RIGHT: list -->
        <div class="list" role="tablist" aria-orientation="vertical" aria-label={c.list.h} data-list>
          {items.map((n, i) => (
            <button type="button" class="li rv" role="tab" id={`li-${n.id}`} data-id={n.id} data-cat={n.cat}
              aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`pv-${n.id}`} tabindex={i === 0 ? 0 : -1}
              style={`--d:${i * 60}ms`}>
              <span class="li__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="li__body">
                <span class="li__meta"><time datetime={n.date}>{n.dot}</time><em class={`chip chip--${n.cat}`}>{n.catLabel}</em></span>
                <strong>{n.title}</strong>
              </span>
              <span class="li__arrow" aria-hidden="true">→</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--grad cta">
    <div class="container">
      <h2>{c.cta.h}</h2>
      <p class="cta__p">{c.cta.p}</p>
      <div class="cta__row">
        <a class="btn btn--sun" href={`/${lang}/book-a-training/`}>{t(lang, 'cta.book')}</a>
        <a class="cta__mail" href={`mailto:${c.cta.email}`}>{c.cta.email}</a>
      </div>
    </div>
  </section>

  <Partners lang={lang} />
</Layout>

<style>
  /* ================= HERO ================= */
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: clamp(560px, 84vh, 800px); display: grid; align-items: center; background: #f3f6fa; color: #0f1626; }

  .hero__tunnel { position: absolute; inset: 0; z-index: -1; overflow: hidden; perspective: 900px;
    perspective-origin: calc(50% + var(--px, 0px)) calc(48% + var(--py, 0px)); transition: perspective-origin 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
  /* newspaper pages: columns, text lines and headline bars, receding toward the centre */
  .paper { position: absolute; background-color: #fcfdff; filter: blur(1.6px); opacity: 0.92;
    background-image:
      repeating-linear-gradient(90deg, transparent 0 14.2%, #fcfdff 14.2% 16.666%),
      repeating-linear-gradient(0deg, rgba(35, 45, 65, 0.6) 0 2px, transparent 2px 7px),
      repeating-linear-gradient(0deg, transparent 0 231px, rgba(25, 32, 50, 0.85) 231px 247px, transparent 247px 252px);
    background-size: 100% 100%, 100% 1764px, 100% 1764px;
    animation: read 70s linear infinite; }
  @keyframes read { from { background-position: 0 0, 0 0, 0 0; } to { background-position: 0 0, 0 -1764px, 0 -1764px; } }
  .paper--l { left: -6%; top: -30%; width: 62%; height: 160%; transform-origin: 0 50%; transform: rotateY(62deg);
    -webkit-mask-image: linear-gradient(90deg, #000 28%, transparent 98%); mask-image: linear-gradient(90deg, #000 28%, transparent 98%); }
  .paper--r { right: -6%; top: -30%; width: 62%; height: 160%; transform-origin: 100% 50%; transform: rotateY(-62deg);
    -webkit-mask-image: linear-gradient(270deg, #000 28%, transparent 98%); mask-image: linear-gradient(270deg, #000 28%, transparent 98%); }
  .paper--t { left: -20%; top: -6%; width: 140%; height: 62%; transform-origin: 50% 0; transform: rotateX(-62deg);
    -webkit-mask-image: linear-gradient(180deg, #000 25%, transparent 98%); mask-image: linear-gradient(180deg, #000 25%, transparent 98%); }
  .paper--b { left: -20%; bottom: -8%; width: 140%; height: 62%; transform-origin: 50% 100%; transform: rotateX(62deg);
    -webkit-mask-image: linear-gradient(0deg, #000 25%, transparent 98%); mask-image: linear-gradient(0deg, #000 25%, transparent 98%); }

  /* blue + mint shards */
  .shard { position: absolute; pointer-events: none; animation: float 9s ease-in-out infinite; }
  .shard--a { top: 0; left: 58%; width: 26%; height: 27%; background: linear-gradient(160deg, #2b86ea, #86c1ff); clip-path: polygon(0 0, 100% 0, 100% 58%, 34% 100%); }
  .shard--b { top: -3%; left: 22%; width: 34%; height: 32%; background: linear-gradient(160deg, rgba(110, 232, 212, 0.8), rgba(255, 255, 255, 0)); clip-path: polygon(12% 0, 100% 0, 62% 100%, 0 42%); animation-delay: -3s; }
  .shard--c { right: -2%; top: 32%; width: 20%; height: 38%; background: linear-gradient(200deg, rgba(110, 232, 212, 0.85), rgba(150, 200, 255, 0.15)); clip-path: polygon(100% 0, 100% 100%, 0 72%); animation-delay: -5s; }
  .shard--d { left: 30%; bottom: 24%; width: 22%; height: 6%; background: linear-gradient(90deg, #2b86ea, #6db2ff); clip-path: polygon(8% 0, 100% 22%, 92% 100%, 0 78%); animation-delay: -1.5s; }
  @keyframes float { 50% { translate: 0 -10px; } }

  .hero__fog { position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 62% at 66% 46%, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.6) 55%, transparent 82%),
                radial-gradient(ellipse 40% 50% at 12% 78%, rgba(255, 255, 255, 0.8), transparent 80%); }

  /* wordmark: vertical BRAINY sitting on a horizontal NEWSROOM, joined by hairlines */
  .hero__brand { position: absolute; z-index: 2; left: clamp(1rem, 4vw, 4rem); bottom: 1.6rem; display: flex; flex-direction: column; align-items: flex-start; pointer-events: none; }
  .hero__v { writing-mode: vertical-rl; padding-left: 0.55rem; border-left: 1px solid #0f1626; margin-bottom: 0.2rem; font: 300 clamp(2.2rem, 4.6vw, 4.2rem) / 1 var(--font-body); letter-spacing: 0.04em; }
  .hero__h { padding-bottom: 0.15rem; border-bottom: 1px solid #0f1626; font: 300 clamp(2.6rem, 7vw, 6.2rem) / 1.05 var(--font-body); letter-spacing: 0.01em; }

  .hero__copy { position: relative; z-index: 2; margin-left: auto; width: min(46%, 40rem); margin-right: clamp(1.5rem, 6vw, 6rem); padding-block: 4rem 9rem; }
  .hero__eyebrow { margin: 0 0 1.4rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; font-size: var(--fs-sm); color: var(--brand); display: flex; align-items: center; gap: 0.8rem; }
  .hero__eyebrow::before { content: ''; width: 2.6rem; height: 2px; background: var(--brand); }
  .hero__title { margin: 0; font: 500 clamp(2.3rem, 5.4vw, 4.6rem) / 1.18 var(--font-display); letter-spacing: -0.01em; color: #0b1220; }
  .hero__title span { display: block; animation: lineIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero__title span:nth-child(2) { animation-delay: 0.18s; }
  @keyframes lineIn { from { opacity: 0; transform: translateY(24px); filter: blur(10px); } to { opacity: 1; transform: none; filter: none; } }
  .hero__lead { margin: 1.6rem 0 0; max-width: 30rem; color: #36415a; font-size: var(--fs-lg); animation: lineIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both; text-wrap: pretty; }

  /* pick-up card */
  .pick { position: absolute; z-index: 3; right: -1.5%; bottom: 7%; width: min(44%, 560px); text-decoration: none; color: #0f1626;
    background: linear-gradient(165deg, #e7ecf3, #ffffff 55%); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 6px;
    box-shadow: 0 30px 60px rgba(20, 40, 80, 0.22), 0 4px 0 rgba(255, 255, 255, 0.8) inset;
    transform-origin: right bottom; transform: perspective(1300px) rotateY(-14deg) rotateX(5deg) rotateZ(-2.2deg);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s; animation: cardIn 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both; }
  @keyframes cardIn { from { opacity: 0; translate: 60px 40px; } to { opacity: 1; translate: 0 0; } }
  .pick:hover, .pick:focus-visible { transform: perspective(1300px) rotateY(-3deg) rotateX(1deg) rotateZ(-0.6deg) translateY(-6px); box-shadow: 0 40px 70px rgba(20, 40, 80, 0.28); outline: none; }
  .pick__bar { display: flex; justify-content: space-between; gap: 1rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid rgba(15, 22, 38, 0.18); font: 700 0.68rem / 1 var(--font-body); letter-spacing: 0.14em; }
  .pick__bar i { font-style: normal; opacity: 0.5; margin: 0 0.3rem; }
  .pick__body { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1.1rem; padding: 1.1rem 1.2rem 1.3rem; align-items: start; }
  .pick__img { overflow: hidden; border-radius: 3px; filter: grayscale(1) contrast(1.08); transition: filter 0.5s; }
  .pick:hover .pick__img { filter: none; }
  .pick__txt { display: grid; gap: 0.35rem; }
  .pick__txt strong { font: 500 1.05rem / 1.35 var(--font-display); }
  .pick__txt small { color: var(--brand); font-weight: 700; letter-spacing: 0.06em; }
  .pick__txt p { margin: 0; font-size: 0.75rem; line-height: 1.6; color: #4a5470; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }

  /* ================= NEWS LIST ================= */
  .news { scroll-margin-top: 4rem; background: #fff; }
  .news__head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 1.2rem 2rem; margin-bottom: 2.4rem; }
  .news__head h2 { margin: 0; color: var(--brand-deep); }
  .news__hint { margin: 0.4rem 0 0; color: var(--muted); font-size: var(--fs-sm); }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0.35rem; background: var(--tint); border-radius: 999px; }
  .filters__btn { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 42px; padding: 0 1.1rem; border: 0; border-radius: 999px; background: transparent; color: var(--brand-deep); font: 700 var(--fs-sm) var(--font-body); cursor: pointer; transition: background 0.25s, color 0.25s, transform 0.25s; }
  .filters__btn b { display: grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.3rem; border-radius: 99px; background: rgba(255, 255, 255, 0.8); font-size: 0.75rem; }
  .filters__btn:hover { transform: translateY(-2px); }
  .filters__btn[aria-pressed='true'] { background: var(--brand); color: #fff; }
  .filters__btn[aria-pressed='true'] b { background: rgba(255, 255, 255, 0.22); color: #fff; }

  .news__grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: clamp(1.6rem, 4vw, 3.4rem); align-items: start; }

  .chip { display: inline-block; font-style: normal; font-weight: 700; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.28rem 0.7rem; border-radius: 99px; }
  .chip--press { background: color-mix(in srgb, var(--brand) 12%, #fff); color: var(--brand-deep); }
  .chip--invite, .chip--expo { background: var(--sun); color: #3a2a0a; }

  /* preview (left) */
  .preview { position: sticky; top: 5.5rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 20px 50px rgba(30, 79, 163, 0.1); }
  .pv[hidden] { display: none; }
  .pv__cover { position: relative; overflow: hidden; animation: cover 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .pv__poster { display: block; width: 100%; height: auto; }
  @keyframes cover { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .pv__cover .chip { position: absolute; left: 1rem; top: 1rem; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2); }
  .pv__body { padding: clamp(1.3rem, 3vw, 2rem); animation: pvIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both; }
  @keyframes pvIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .pv__body time { color: var(--brand); font-weight: 700; font-size: var(--fs-sm); letter-spacing: 0.06em; }
  .pv__body h3 { margin: 0.4rem 0 1rem; color: var(--brand-deep); font-size: clamp(1.4rem, 2.6vw, 1.9rem); line-height: 1.25; text-wrap: balance; }
  .pv__body p { margin: 0 0 0.9rem; color: var(--muted); text-wrap: pretty; }
  .pv__meta { display: grid; gap: 0.4rem; margin: 1.2rem 0; padding: 1rem 1.2rem; background: var(--tint); border-radius: var(--radius-md); }
  .pv__meta div { display: grid; grid-template-columns: 5rem 1fr; gap: 0.8rem; }
  .pv__meta dt { color: var(--brand); font-weight: 700; font-size: var(--fs-sm); }
  .pv__meta dd { margin: 0; color: var(--brand-deep); font-weight: 700; }
  .pv__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .pv__nav { display: flex; align-items: center; gap: 0.8rem; margin-left: auto; color: var(--muted); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; }
  .pv__nav button { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--brand); color: #fff; font-size: 1.3rem; line-height: 1; cursor: pointer; transition: transform 0.2s, background 0.2s; }
  .pv__nav button:hover { transform: scale(1.1); background: var(--brand-deep); }

  /* list (right) */
  .list { display: grid; border-top: 1px solid var(--line); }
  .li { display: grid; grid-template-columns: auto 1fr auto; gap: 1.1rem; align-items: center; width: 100%; text-align: left; padding: 1.2rem 1rem 1.2rem 1.1rem; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: inherit; font: inherit; cursor: pointer; position: relative; outline: none;
    transition: background 0.3s, padding 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .li[hidden] { display: none; }
  .li::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--brand); transform: scaleY(0); transform-origin: top; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .li:hover { background: color-mix(in srgb, var(--brand) 4%, #fff); padding-left: 1.5rem; }
  .li:focus-visible { box-shadow: inset 0 0 0 3px var(--sun); }
  .li[aria-selected='true'] { background: color-mix(in srgb, var(--brand) 9%, #fff); padding-left: 1.5rem; }
  .li[aria-selected='true']::before { transform: scaleY(1); }
  .li__n { font: 300 1.6rem / 1 var(--font-body); color: color-mix(in srgb, var(--brand) 45%, #fff); font-variant-numeric: tabular-nums; transition: color 0.3s; }
  .li[aria-selected='true'] .li__n { color: var(--brand); }
  .li__body { display: grid; gap: 0.45rem; min-width: 0; }
  .li__meta { display: flex; align-items: center; gap: 0.7rem; }
  .li__meta time { color: var(--muted); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; }
  .li__body strong { color: var(--brand-deep); font-size: 1.05rem; line-height: 1.4; text-wrap: balance; }
  .li__arrow { color: var(--brand); font-size: 1.3rem; opacity: 0; translate: -10px 0; transition: opacity 0.3s, translate 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .li:hover .li__arrow, .li[aria-selected='true'] .li__arrow { opacity: 1; translate: 0 0; }

  /* scroll reveal (only active once JS runs) */
  :global(.rv-on) .rv { opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms), background 0.3s, padding 0.35s; }
  :global(.rv-on) .rv.in { opacity: 1; transform: none; }

  /* CTA */
  .cta .container { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.4rem; }
  .cta h2 { max-width: 20ch; text-wrap: balance; }
  .cta__p { max-width: 36rem; margin: 0; font-size: var(--fs-lg); color: rgba(255, 255, 255, 0.9); }
  .cta__row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1.4rem; }
  .cta__mail { color: #fff; font-weight: 700; font-size: var(--fs-lg); }

  @media (max-height: 760px) { .preview { position: static; } }
  @media (max-width: 1000px) {
    .hero__copy { width: min(54%, 36rem); }
    .pick { width: min(52%, 520px); }
  }
  @media (max-width: 900px) {
    .hero { min-height: 0; align-items: start; }
    .hero__copy { width: auto; margin: 0; padding: 3rem 1.5rem 1.2rem; }
    .hero__fog { background: radial-gradient(ellipse 90% 60% at 50% 30%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.5) 60%, transparent 90%); }
    .pick { position: relative; right: auto; bottom: auto; width: auto; margin: 1rem 1.2rem 7.5rem; transform: perspective(1000px) rotateX(3deg) rotateZ(-1deg); }
    .hero { display: block; }
    .news__grid { grid-template-columns: 1fr; }
    .preview { position: static; scroll-margin-top: 5rem; }
  }
  @media (max-width: 560px) {
    .pick__body { grid-template-columns: 1fr; }
    .li { grid-template-columns: 1fr auto; }
    .li__n { display: none; }
    .pv__meta div { grid-template-columns: 4rem 1fr; }
    .filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; gap: 0.35rem; border-radius: 24px; }
    .filters__btn { justify-content: center; gap: 0.4rem; min-height: 44px; padding: 0 0.6rem; text-align: center; line-height: 1.2; font-size: 0.85rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .paper, .shard, .hero__title span, .hero__lead, .pick, .pv__cover, .pv__body { animation: none; }
    .pick, .li, .li::before, .li__arrow { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* scroll reveal */
    if ('IntersectionObserver' in window && !reduce) {
      document.documentElement.classList.add('rv-on');
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
      document.querySelectorAll('.rv').forEach(function (el) { io.observe(el); });
    }

    /* hero: the corridor follows the cursor */
    var hero = document.querySelector('[data-hero]');
    if (hero && !reduce) {
      var tunnel = hero.querySelector('.hero__tunnel');
      hero.addEventListener('pointermove', function (e) {
        var r = hero.getBoundingClientRect();
        tunnel.style.setProperty('--px', (((e.clientX - r.left) / r.width - 0.5) * 170) + 'px');
        tunnel.style.setProperty('--py', (((e.clientY - r.top) / r.height - 0.5) * 120) + 'px');
      });
      hero.addEventListener('pointerleave', function () { tunnel.style.setProperty('--px', '0px'); tunnel.style.setProperty('--py', '0px'); });
    }

    /* news: click the list -> preview on the left */
    var list = document.querySelector('[data-list]');
    if (!list) return;
    var preview = document.querySelector('[data-preview]');
    var items = Array.prototype.slice.call(list.querySelectorAll('.li'));
    var panels = {};
    document.querySelectorAll('.pv').forEach(function (p) { panels[p.getAttribute('data-id')] = p; });
    var filters = Array.prototype.slice.call(document.querySelectorAll('[data-filter]'));

    function visible() { return items.filter(function (i) { return !i.hidden; }); }
    function current() { return items.filter(function (i) { return i.getAttribute('aria-selected') === 'true'; })[0]; }

    function select(id, o) {
      o = o || {};
      var cur = items.filter(function (i) { return i.getAttribute('data-id') === id; })[0];
      if (!cur) return;
      items.forEach(function (i) {
        var on = i === cur;
        i.setAttribute('aria-selected', on ? 'true' : 'false');
        i.tabIndex = on ? 0 : -1;
        var p = panels[i.getAttribute('data-id')];
        if (p) p.hidden = !on;
      });
      var v = visible(), pos = panels[id].querySelector('[data-pos]');
      if (pos) pos.textContent = (v.indexOf(cur) + 1) + ' / ' + v.length;
      if (o.focus) cur.focus();
      if (o.scroll && innerWidth <= 900) preview.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      if (o.hash !== false) { try { history.replaceState(null, '', '#' + id); } catch (e) {} }
    }

    items.forEach(function (i) {
      i.addEventListener('click', function () { select(i.getAttribute('data-id'), { scroll: true }); });
      i.addEventListener('keydown', function (e) {
        var v = visible(), idx = v.indexOf(i), n = v.length, k = e.key, t = null;
        if (k === 'ArrowDown' || k === 'ArrowRight') t = v[(idx + 1) % n];
        if (k === 'ArrowUp' || k === 'ArrowLeft') t = v[(idx - 1 + n) % n];
        if (k === 'Home') t = v[0];
        if (k === 'End') t = v[n - 1];
        if (t) { e.preventDefault(); select(t.getAttribute('data-id'), { focus: true }); }
      });
    });

    /* prev / next inside the preview */
    document.addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('[data-step]') : null;
      if (!b) return;
      var v = visible(), idx = v.indexOf(current()), n = v.length;
      select(v[(idx + parseInt(b.getAttribute('data-step'), 10) + n) % n].getAttribute('data-id'));
    });

    /* filters */
    filters.forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.getAttribute('data-filter');
        filters.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        items.forEach(function (i) { i.hidden = !(f === 'all' || i.getAttribute('data-cat') === f); });
        var cur = current();
        select((!cur || cur.hidden ? visible()[0] : cur).getAttribute('data-id'), { hash: false });
      });
    });

    /* hero pick-up card -> jump to that story */
    var pick = document.querySelector('[data-pick]');
    if (pick) pick.addEventListener('click', function (e) {
      e.preventDefault();
      filters[0] && filters[0].click();
      select(pick.getAttribute('data-pick'));
      document.getElementById('news-list').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });

    /* open a story from the URL hash (#n3) */
    var h = location.hash.replace('#', '');
    if (h && panels[h]) select(h, { hash: false });
  })();
</script>
---
import { optimizedImage } from '../../media/images';
import Layout from '../../layouts/Layout.astro';
import Partners from '../../components/Partners.astro';
import { t, type Lang } from '../../i18n/utils';
import home from '../../content/pages/home.json';
import brainy from '../../content/pages/brainy.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = home[lang];
const b = brainy[lang];
const heroOriginal = '/images/hero photo.png';
const hasOptimizedHero = optimizedImage(heroOriginal) !== heroOriginal;
const heroImg = hasOptimizedHero ? '/images/optimized/hero-800.webp' : heroOriginal;
const heroSizes = '(max-width: 860px) 100vw, 56vw';
const heroSources = (format: 'avif' | 'webp') => hasOptimizedHero
  ? [480, 800, 1280].map(width => `/images/optimized/hero-${width}.${format} ${width}w`).join(', ')
  : undefined;
const heroAvif = heroSources('avif');
const poster = optimizedImage(c.video.poster);
const posterSources = poster === '/images/optimized/video-poster.webp'
  ? `/images/optimized/video-poster-768.webp 768w, ${poster} 1280w`
  : undefined;
const pictureSizes = '(max-width: 988px) calc(100vw - 3rem), 940px';
const pillColors = ['#E2655F', '#F7C948', '#6FA6E8', '#5BB487'];

// Quote cards: teacher card first, then the principal voices.
// `pos` is the object-position of the photo, so the people stay in the middle of the crop.
const principalTag = lang === 'zh' ? '參與校長分享' : "Participating Principal's Sharing";
const voiceImgs = ['/images/5.jpg', '/images/12.jpg'];
const quotes = [
  { quote: c.takeaways.quote.q, tag: c.takeaways.quote.school, img: c.takeaways.quote.img, pos: '50% 50%' },
  ...b.voices.items.map((v, i) => ({ quote: v.quote, tag: principalTag, img: voiceImgs[i], pos: '50% 50%' })),
];

// CTA photo cards: 4 workshop tiles + the 4 takeaways. Swap the image paths freely.
const extraImgs = ['/images/11.jpg', '/images/8.jpg', '/images/10.jpg', '/images/7.jpg'];
const cards = [
  ...c.tiles.map((x) => ({ label: x.label, img: x.img })),
  ...c.takeaways.items.map((x, i) => ({ label: x.h, img: extraImgs[i] })),
];
const ratios = ['1 / 1.18', '1 / 1', '1 / 1.1', '1 / 1.22'];
const colA = cards.filter((_, i) => i % 2 === 0).map((x, i) => ({ ...x, r: ratios[i % 4] }));
const colB = cards.filter((_, i) => i % 2 === 1).map((x, i) => ({ ...x, r: ratios[(i + 2) % 4] }));
const bookHref = `/${lang}/book-a-training/`;
---
<Layout lang={lang} title={t(lang, 'nav.home')} description={c.lead}>
  <Fragment slot="head">
    {heroAvif && <link rel="preload" as="image" type="image/avif" imagesrcset={heroAvif} imagesizes={heroSizes} fetchpriority="high" />}
  </Fragment>

  <!-- 1. HERO (unchanged) -->
  <section class="hero">
    <div class="hero__curves" aria-hidden="true">
      <svg class="curve curve--a" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M12 88 C4 36 58 4 92 28 C122 50 84 100 52 76" stroke="#B9A5E8" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--b" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M14 60 C30 8 92 8 106 52 C116 84 70 112 44 94" stroke="#F08A84" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--c" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M10 96 C30 30 70 20 108 34" stroke="#F7C948" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--d" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M12 88 C4 36 58 4 92 28 C122 50 84 100 52 76" stroke="#8FB8F0" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--e" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M14 60 C30 8 92 8 106 52 C116 84 70 112 44 94" stroke="#E9A8E0" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--f" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M12 88 C4 36 58 4 92 28 C122 50 84 100 52 76" stroke="#F7C948" stroke-width="12" stroke-linecap="round"/></svg>
    </div>
    <div class="container hero__grid">
      <div class="hero__text">
        <!-- <span class="pill">{c.badge}</span> -->
        <h1>{c.title}<br /><span class="accent headline-choices">
          {c.accents.map(word => <span class="headline-measure" aria-hidden="true">{word}</span>)}
          <span class="typewriter" data-words={JSON.stringify(c.accents)}>{c.accents[0]}</span>
        </span></h1>
        <p class="sub">{c.sub}</p>
        <p class="lead">{c.lead}</p>
        <div class="actions">
          <a class="btn btn--sun" href={`/${lang}/about/`}>{c.learn} <span aria-hidden="true">→</span></a>
          <a class="watch" href="#video"><span class="watch__ring" aria-hidden="true">▶</span>{c.watch}</a>
        </div>
        <!-- <p class="proof">{c.proof}</p> -->
      </div>
    </div>
    <div class="hero__photo">
      <picture>
        {heroAvif && <source type="image/avif" srcset={heroAvif} sizes={heroSizes} />}
        <img src={heroImg} srcset={heroSources('webp')} sizes={heroSizes} width="1672" height="941" alt="" fetchpriority="high" decoding="async" data-hide-on-error />
      </picture>
    </div>
  </section>

  <!-- 2 + 3. ONE CONTINUOUS "BRAIN GAME" SCENE behind intro and video -->
  <div class="scene">
    <svg class="scene__art" viewBox="0 0 1440 1500" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
      <!-- rings -->
      <circle cx="90" cy="150" r="64" stroke="#8FB8F0" stroke-width="10" opacity=".55"/>
      <circle cx="1350" cy="470" r="86" stroke="#F7C948" stroke-width="10" opacity=".5"/>
      <circle cx="1240" cy="1180" r="52" stroke="#E9A8E0" stroke-width="10" opacity=".55"/>
      <circle cx="170" cy="1260" r="74" stroke="#B9A5E8" stroke-width="10" opacity=".5"/>
      <!-- squiggles -->
      <path class="fl fl--1" d="M40 520 q30 -50 60 0 t60 0 t60 0 t60 0" stroke="#F08A84" stroke-width="10" stroke-linecap="round" opacity=".8"/>
      <path class="fl fl--2" d="M1120 90 q30 -50 60 0 t60 0 t60 0" stroke="#F7C948" stroke-width="10" stroke-linecap="round" opacity=".8"/>
      <path class="fl fl--3" d="M1180 860 q30 -50 60 0 t60 0 t60 0" stroke="#8FD0B0" stroke-width="10" stroke-linecap="round" opacity=".75"/>
      <path class="fl fl--2" d="M60 900 q30 -50 60 0 t60 0 t60 0" stroke="#A8D1E7" stroke-width="10" stroke-linecap="round" opacity=".75"/>
      <!-- brain-game curves (same family as the hero) -->
      <path class="fl fl--3" d="M600 60 C560 10 470 30 480 100 C490 150 570 150 600 100" stroke="#B9A5E8" stroke-width="12" stroke-linecap="round" opacity=".6"/>
      <path class="fl fl--1" d="M1260 1380 C1300 1300 1390 1320 1380 1400 C1370 1450 1300 1460 1270 1420" stroke="#F08A84" stroke-width="12" stroke-linecap="round" opacity=".6"/>
      <!-- blobs / pieces -->
      <path d="M760 1440 c-30 -40 10 -90 60 -80 c60 10 70 70 30 100 c-30 22 -70 20 -90 -20z" fill="#F7C948" opacity=".55"/>
      <path d="M20 700 c-10 -50 50 -70 90 -40 c30 24 20 80 -20 90 c-40 10 -60 -20 -70 -50z" fill="#5BB487" opacity=".5"/>
      <rect x="1320" y="660" width="54" height="54" rx="14" fill="#E2655F" opacity=".6" transform="rotate(18 1347 687)"/>
      <rect x="640" y="1010" width="40" height="40" rx="10" fill="#8FB8F0" opacity=".55" transform="rotate(-14 660 1030)"/>
      <!-- dots -->
      <g fill="#fff" opacity=".5"><circle cx="420" cy="60" r="6"/><circle cx="1010" cy="700" r="7"/><circle cx="300" cy="1120" r="6"/><circle cx="1090" cy="1440" r="7"/><circle cx="52" cy="380" r="5"/></g>
    </svg>

    <!-- 2. PROGRAMME INTRO -->
    <section class="section scene__intro">
      <div class="container two">
        <div class="bubble">
          <h2 class={`bubble__h bubble__h--${lang}`}>{c.intro.h}</h2>
          <p>{c.intro.p1}</p>
          <p class="bubble__support">{c.intro.support}</p>
          <a class="more" href={`/${lang}/about/`}>{c.intro.link} <span aria-hidden="true">→</span></a>
        </div>

        <div class="shots" data-shots>
          <span class="shots__back" aria-hidden="true"></span>
          <div class="shots__frame">
            {c.intro.slides.map((s, i) => (
              <figure class={`shot${i === 0 ? ' is-on' : ''}`} style={`background:${s.color}`} aria-hidden={i !== 0}>
                <template>
                  <img src={optimizedImage(s.img)} alt={s.label} decoding="async" data-hide-on-error />
                </template>
                {i === 0 && <noscript><img src={optimizedImage(s.img)} alt={s.label} loading="lazy" decoding="async" /></noscript>}
              </figure>
            ))}
          </div>
          <div class="dots">
            {c.intro.slides.map((s, i) => (
              <button type="button" class={`dot${i === 0 ? ' is-on' : ''}`} aria-label={s.label} aria-current={i === 0 ? 'true' : 'false'} data-i={i}></button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VIDEO -->
    <section class="section scene__video" id="video">
      <div class="container">
        <header class="head head--light"><h2>{c.video.h}</h2></header>
        <div class="stage">
          {c.video.strips.map((s, i) => <span class={`strip strip--${i + 1}`} aria-hidden="true">{s}</span>)}
          <div class="video" data-video data-src={c.video.src}>
            {poster && <template data-video-poster>
              <img class="video__poster" src={poster} srcset={posterSources} sizes={pictureSizes} alt="" decoding="async" fetchpriority="low" />
            </template>}
            {poster && <noscript><img class="video__poster" src={poster} srcset={posterSources} sizes={pictureSizes} alt="" loading="lazy" decoding="async" /></noscript>}
            <button type="button" class="play" aria-label={c.watch}><span aria-hidden="true">▶</span></button>
            {!c.video.src && <small class="video__note">{c.video.note}</small>}
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- 4. KEY TAKEAWAYS: fixed panel left, auto-scrolling carousel right -->
  <section class="section section--tint">
    <div class="container take-grid">
      <div class="panel">
        <h2>{c.takeaways.h}</h2>
        <ol class="pills">
          {c.takeaways.items.map((x, i) => (
            <li class="pill-row" style={`--p:${pillColors[i]}`}><span class="pill-row__n">{i + 1}</span>{x.h}</li>
          ))}
        </ol>
        <div class="rail-bar">
          <button type="button" class="arrow" data-dir="-1" aria-label="Previous">←</button>
          <button type="button" class="arrow" data-dir="1" aria-label="Next">→</button>
        </div>
      </div>
      <div class="rail" data-rail>
        <div class="rail__track">
          {[0, 1].map((copy) => (
            <div class="rail__set" aria-hidden={copy === 1 ? 'true' : undefined}>
              {quotes.map((q) => (
                <figure class="qcard">
                  <img src={optimizedImage(q.img)} alt="" style={`object-position:${q.pos}`} loading="lazy" data-hide-on-error />
                  <blockquote>{q.quote}</blockquote>
                  <figcaption>{q.tag}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. BOOK A TRAINING: last block before the footer -->
  <section class="section cta2" id="contact">
    <div class="container">
      <div class="cta2__card">
        <div class="cta2__text">
          <div class="cta2__icons" aria-hidden="true"><span>🧠</span><span>🤝</span><span>🌱</span></div>
          <h2 class="cta2__h">{c.cta.h1}<br />{c.cta.h2}</h2>
          <p class="cta2__p">{b.contact.ask}</p>
          <div class="cta2__actions">
            <a class="btn btn--primary" href={bookHref}>{t(lang, 'cta.book')}</a>
            <a class="btn ghost" href={`/${lang}/service/`}>{c.learn}</a>
          </div>
          <p class="cta2__foot">
            {lang === 'zh' ? '聯絡我們' : 'Contact us'}:<br />
            📞 <a href="https://wa.me/85295472118" target="_blank" rel="noopener">wa.me/85295472118</a><br />
            📧 <a href="mailto:info@neuroseed.org">info@neuroseed.org</a>
          </p>
        </div>

        <div class="cols" data-cols>
          {[colA, colB].map((col, ci) => (
            <div class={`col col--${ci ? 'b' : 'a'}`}>
              <div class="col__track">
                {[0, 1].map((copy) => (
                  <div class="col__set" aria-hidden={copy === 1 ? 'true' : undefined} inert={copy === 1}>
                    {col.map((x) => (
                      <article class="pcard" style={`aspect-ratio:${x.r}`}>
                        <img src={optimizedImage(x.img)} alt="" loading="lazy" data-hide-on-error />
                        <span class="pcard__label">{x.label}</span>
                      </article>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. PARTNERS -->
  <Partners lang={lang} />

</Layout>

<style>
  .head { text-align: center; max-width: 46rem; margin: 0 auto 2.8rem; }
  .head h2 { text-wrap: balance; }
  .head--light h2,
  .scene .head--light h2 { color: #fff; }

  /* 1 Hero (unchanged) */
  .hero { position: relative; overflow: hidden; isolation: isolate; color: #fff; min-height: min(86vh, 720px); display: flex; align-items: center;
    background: radial-gradient(120% 120% at 15% 10%, #2A63C2 0%, var(--brand) 45%, var(--brand-deep) 100%); }
  .hero__grid { position: relative; z-index: 2; padding-block: 4rem; }
  .hero__text { max-width: 560px; }
  .hero .pill { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.3); color: #fff; }
  .hero h1 { margin: 1.2rem 0 0.9rem; text-wrap: balance; color: #fff; }
  .hero .accent { color: var(--sun); background: none; }
  .headline-choices { display: block; }
  .headline-measure { display: none; }
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    .headline-choices { display: grid; }
    .headline-choices > span { grid-area: 1 / 1; }
    .headline-measure { display: block; visibility: hidden; }
  }
  .hero .typewriter::after { color: var(--sun); }
  .hero .sub { font-weight: 700; color: #fff; margin-bottom: 0.6rem; }
  .hero .lead { color: rgba(255,255,255,0.88); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; margin: 1.8rem 0 1.4rem; }
  .hero .btn--sun { font-weight: 700; min-height: 54px; padding-inline: 1.8rem; box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
  .watch { display: inline-flex; align-items: center; gap: 0.8rem; color: #fff; text-decoration: none; font-weight: 500; }
  .watch__ring { width: 54px; height: 54px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.7); display: grid; place-items: center; font-size: 0.9rem; transition: background 0.2s; }
  .watch:hover .watch__ring { background: rgba(255,255,255,0.16); }
  .proof { font-size: var(--fs-sm); color: rgba(255,255,255,0.75); max-width: 46ch; }
  .hero__photo { position: absolute; z-index: 1; top: 0; right: 0; bottom: 0; width: 56%;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 34%); mask-image: linear-gradient(to right, transparent 0, #000 34%); }
  .hero__photo picture { display: block; height: 100%; }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 40% center; }
  .typewriter::after { content: '|'; margin-left: 2px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero__curves { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .curve { position: absolute; width: var(--s, 90px); height: var(--s, 90px); opacity: 0.9; rotate: var(--r, 0deg); animation: float var(--t, 7s) ease-in-out var(--dl, 0s) infinite; }
  .curve--a { --s: 90px;  --r: -20deg; --t: 7s;   top: 4%;    left: 1.5%; }
  .curve--b { --s: 110px; --r: 25deg;  --t: 8.5s; --dl: -2s;  top: 58%;  left: -1%; }
  .curve--c { --s: 120px; --r: 0deg;   --t: 6.5s; --dl: -1s;  bottom: 3%; left: 62%; }
  .curve--d { --s: 130px; --r: 200deg; --t: 9s;   --dl: -3s;  top: 3%;   left: 52%; }
  .curve--e { --s: 100px; --r: -35deg; --t: 7.5s; --dl: -4s;  top: 14%;  right: 2%; }
  .curve--f { --s: 120px; --r: 160deg; --t: 8s;   --dl: -2.5s; bottom: 3%; right: 3%; }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -16px; } }

  /* 2+3 Shared scene */
  .scene { position: relative; overflow: hidden; isolation: isolate; color: #fff;
    background: linear-gradient(180deg, var(--brand) 0%, #1B4592 55%, var(--brand-deep) 100%); }
  .scene__art { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .scene .section { position: relative; z-index: 1; background: none; }
  .fl { animation: drift 9s ease-in-out infinite alternate; }
  .fl--2 { animation-duration: 11s; animation-delay: -3s; }
  .fl--3 { animation-duration: 13s; animation-delay: -6s; }
  @keyframes drift { to { transform: translate(0, -14px); } }

  /* 2 Intro */
  .two { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: center; }
  .bubble { position: relative; background: #fff; color: #1F2A44; padding: clamp(2.4rem, 4vw, 4rem) clamp(2.4rem, 4.6vw, 4.8rem);
    border-radius: 120px 200px 140px 220px / 160px 140px 200px 150px; box-shadow: 0 24px 60px rgba(8, 24, 70, 0.35);
    container-type: inline-size; }
  .bubble::before { content: ''; position: absolute; z-index: -1; inset: 1.2rem -1.2rem -1.2rem 1.2rem; border-radius: inherit; background: rgba(255,255,255,.18); rotate: 2deg; }
  .bubble h2 { color: var(--brand-deep); margin: 0 0 1.2rem; font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1.25; text-wrap: balance; }
  /* Chinese headline stays on ONE row and scales with the bubble width (cqw = 1% of bubble width) */
  .bubble .bubble__h--zh { white-space: nowrap; font-size: min(2.1rem, 6cqw); letter-spacing: -0.01em; }
  .bubble p { margin: 0 0 1rem; color: #3A4660; line-height: 1.65; }
  .bubble .bubble__support { font: 700 1.05rem / 1.45 var(--font-display); color: var(--brand); margin-bottom: 1.2rem; }
  .more { display: inline-block; font-weight: 700; color: var(--brand-deep); text-decoration: underline; text-underline-offset: 5px; }
  .more:hover { color: var(--brand); }

  .shots { position: relative; padding: 1rem; }
  .shots__back { position: absolute; inset: 0 2.5rem 2rem 0; background: var(--sun); opacity: .9;
    border-radius: 42% 58% 55% 45% / 52% 40% 60% 48%; rotate: -6deg; }
  .shots__frame { position: relative; aspect-ratio: 1 / 0.9; overflow: hidden; margin-left: 1.6rem;
    border-radius: 55% 45% 50% 50% / 48% 56% 44% 52%; box-shadow: 0 20px 50px rgba(8, 24, 70, .4); background: var(--brand-deep); }
  .shot { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1s ease; }
  .shot.is-on { opacity: 1; }
  .shot img { width: 100%; height: 100%; object-fit: cover; }
  .dots { position: relative; display: flex; justify-content: center; gap: .6rem; margin-top: 1.1rem; }
  .dot { width: 12px; height: 12px; padding: 0; border-radius: 50%; border: 2px solid #fff; background: transparent; cursor: pointer; transition: background .2s, width .2s; }
  .dot.is-on { background: #fff; width: 28px; border-radius: 999px; }
  
  /* 3 Video */
  .stage { position: relative; max-width: 940px; margin-inline: auto; }
  .strip {
    position: absolute; z-index: 3;
    padding: .75rem 1.6rem;
    font: 700 clamp(1rem, 1.6vw, 1.25rem) / 1.2 var(--font-display);
    color: #1F2A10; background: #D6E36A; border-radius: 10px; white-space: nowrap;
    box-shadow: 0 12px 28px rgba(5, 16, 50, .45), 0 0 0 3px rgba(255, 255, 255, .85);
    transition: transform .3s cubic-bezier(.34, 1.56, .64, 1);
  }
  .strip:hover { transform: translateY(-4px) rotate(0deg); }
  .strip--1 { top: -1.5rem;  right: 4%;   rotate: 4deg; }
  .strip--2 { top: 36%;      left: -2.6rem; rotate: -6deg; background: var(--sun); }
  .strip--3 { bottom: -1.5rem; left: 6%;  rotate: -3deg; background: #A8D1E7; }
  .strip--4 { bottom: 16%;   right: -2.6rem; rotate: 5deg; }
  .video { position: relative; z-index: 1; aspect-ratio: 16 / 9; border-radius: 2rem; overflow: hidden; background: var(--brand-deep);
    box-shadow: 0 28px 70px rgba(5, 16, 50, .5); display: grid; place-items: center; }
  .video__poster, .video video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .video__poster { opacity: .8; }
  .play { position: relative; width: clamp(76px, 11vw, 112px); aspect-ratio: 1; border-radius: 50%; border: 0; background: var(--sun); color: #1B1B18;
    font-size: clamp(1.6rem, 3vw, 2.4rem); cursor: pointer; display: grid; place-items: center; padding-left: .3em;
    box-shadow: 0 0 0 12px rgba(255,255,255,.22), 0 14px 30px rgba(0,0,0,.35); transition: transform .2s; }
  .play:hover { transform: scale(1.07); }
  .video__note { position: absolute; bottom: .9rem; left: 0; right: 0; text-align: center; color: rgba(255,255,255,.85); }
  .video.is-playing .play, .video.is-playing .video__poster, .video.is-playing .video__note { display: none; }

  /* 4 Takeaways rail */
  .take-grid { display: grid; grid-template-columns: minmax(300px, 380px) minmax(0, 1fr); gap: 2rem; align-items: stretch; }
  .rail-bar { display: flex; gap: .6rem; margin-top: auto; }
  .arrow { width: 46px; height: 46px; border-radius: 50%; border: 2px solid #fff; background: transparent; color: #fff; font-size: 1.1rem; cursor: pointer; transition: background .2s, color .2s; }
  .arrow:hover { background: #fff; color: var(--brand-deep); }
  .rail { min-width: 0; overflow-x: auto; scrollbar-width: none; cursor: grab; padding-block: .5rem;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 92%, transparent); mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 92%, transparent); }
  .rail::-webkit-scrollbar { display: none; }
  .rail.is-drag { cursor: grabbing; user-select: none; }
  .rail__track { display: flex; width: max-content; height: 100%; }
  .rail__set { display: flex; gap: 1.5rem; padding-right: 1.5rem; }
  .panel { padding: 2rem 1.6rem; border-radius: 28px; color: #fff; background: linear-gradient(160deg, #2A63C2, var(--brand-deep)); display: flex; flex-direction: column; gap: 1.2rem; }
  .take-grid .panel h2 { color: #fff !important; font-size: clamp(1.5rem, 2.6vw, 2rem); margin: 0; text-wrap: balance; }
  .pills { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .pill-row { display: flex; align-items: center; gap: .8rem; padding: .7rem 1rem; border-radius: 999px; background: var(--p); color: #fff; font: 700 1rem / 1.25 var(--font-display); }
  .pill-row__n { flex: none; width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; background: #fff; color: #1F2A44; font-size: .95rem; }
  .qcard { flex: 0 0 min(340px, 78vw); margin: 0; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; }
  .qcard img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--brand-deep); pointer-events: none; }
  .qcard blockquote { margin: 0; padding: 1.6rem 1.7rem .9rem; flex: 1; font: 600 1.1rem / 1.5 var(--font-display); color: var(--brand-deep); }
  .qcard figcaption { margin: 0 1.7rem 1.6rem; padding: .55rem 1rem; align-self: flex-start; border-radius: 16px; background: var(--sun); color: #1B1B18; font-size: var(--fs-sm); font-weight: 700; line-height: 1.4; }

  /* 6 Book a training: split card, text left, two scrolling photo columns right */
  .cta2__card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center;
    background: #fff; border-radius: 44px; padding: clamp(1.6rem, 4vw, 3.2rem); box-shadow: 0 24px 60px rgba(30, 79, 163, .16); overflow: hidden; }
  .cta2__icons { display: flex; gap: .6rem; margin-bottom: 1.6rem; }
  .cta2__icons span { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--tint); font-size: 1.25rem; }
  .cta2__h { color: var(--brand-deep); text-wrap: balance; margin: 0 0 1.1rem; font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1.12; }
  .cta2__p { color: var(--muted); max-width: 34ch; margin: 0 0 1.8rem; font-size: var(--fs-lg); }
  .cta2__actions { display: flex; flex-wrap: wrap; gap: .9rem; }
  .cta2__actions .btn { min-height: 54px; padding-inline: 1.8rem; font-weight: 700; }
  .cta2__actions .btn--primary { box-shadow: 0 10px 24px rgba(30, 79, 163, .3); }
  .ghost { background: transparent; border: 2px solid var(--brand-deep); color: var(--brand-deep); }
  .ghost:hover { background: var(--brand-deep); color: #fff; border-color: var(--brand-deep); }
  .cta2__foot { margin: 2.2rem 0 0; line-height: 1.8; font-size: var(--fs-sm); color: var(--muted); }
  .cta2__foot a { color: var(--brand); font-weight: 700; }

  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; height: clamp(440px, 64vh, 640px); overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 91%, transparent); mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 91%, transparent); }
  .col { min-width: 0; overflow: hidden; }
  .col--b { padding-top: 3.2rem; }               /* staggered, like the reference */
  .col__track { display: flex; flex-direction: column; animation: colUp 42s linear infinite; will-change: transform; }
  .col--b .col__track { animation-name: colDown; animation-duration: 50s; }
  .col__set { display: flex; flex-direction: column; gap: 1rem; padding-bottom: 1rem; }
  .cols:hover .col__track, .cols:focus-within .col__track { animation-play-state: paused; }
  @keyframes colUp { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  @keyframes colDown { from { transform: translateY(-50%); } to { transform: translateY(0); } }

  .pcard { position: relative; overflow: hidden; border-radius: 26px; background: linear-gradient(160deg, #6FA6E8, var(--brand)); isolation: isolate; }
  .pcard img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
  .pcard:hover img { transform: scale(1.06); }
  .pcard__label { position: absolute; z-index: 2; left: .8rem; bottom: .8rem; max-width: calc(100% - 1.6rem); padding: .45rem 1rem; border-radius: 999px;
    font: 600 .9rem / 1.25 var(--font-body); color: #fff; background: rgba(255, 255, 255, .22); border: 1.5px solid rgba(255, 255, 255, .7);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); text-shadow: 0 1px 4px rgba(0, 0, 0, .35); }

  @media (max-width: 1279px) {
    .curve--a, .curve--b { display: none; }
  }
  @media (max-width: 1000px) {
    .cta2__card { grid-template-columns: 1fr; }
    .cta2__p { max-width: none; }
    .cols { height: 440px; }
  }
  @media (max-width: 860px) {
    .take-grid { grid-template-columns: 1fr; }
    .two { grid-template-columns: 1fr; gap: 2.4rem; }
    .bubble { padding: 2.6rem 2.2rem; border-radius: 48px; }
    .hero { flex-direction: column; align-items: stretch; min-height: 0; }
    .hero__grid { padding-block: 3rem 1rem; }
    .hero__photo { position: relative; width: 100%; height: 340px; -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 30%); mask-image: linear-gradient(to bottom, transparent 0, #000 30%); }
    .curve--d, .curve--c { display: none; }
    .curve--e { top: auto; bottom: 250px; right: 3%; }
    .curve--f { bottom: 14px; right: 4%; }

    /* Bigger text inside the 4 key-takeaway pills on mobile */
    .pill-row { font-size: 1.2rem; padding: .9rem 1.2rem; gap: .9rem; }
    .pill-row__n { width: 2.5rem; height: 2.5rem; font-size: 1.1rem; }

    /* Video label cards: no overlap on tablet/phone, a tidy readable row UNDER the video */
    .stage { display: flex; flex-wrap: wrap; justify-content: center; gap: .7rem; }
    .video { order: 0; flex: 0 0 100%; }
    .strip { order: 1; position: static; rotate: 0deg; font-size: .95rem; padding: .55rem 1.1rem; box-shadow: 0 6px 16px rgba(5, 16, 50, .35); }
  }
  @media (max-width: 520px) {
    .cta2 .container { width: min(100% - 1.5rem, var(--container)); }
    .cta2__card { border-radius: 28px; padding: 1.3rem 1.1rem 1.1rem; gap: 1.6rem; }
    .cta2__icons { margin-bottom: 1.1rem; }
    .cta2__h { font-size: 1.9rem; }
    .cta2__p { font-size: 1.02rem; margin-bottom: 1.3rem; }
    .cta2__actions { flex-direction: column; gap: .7rem; }
    .cta2__actions .btn { width: 100%; min-height: 52px; padding-inline: 1rem; font-size: .98rem; text-align: center; white-space: nowrap; }
    .cta2__foot { margin-top: 1.3rem; }
    .cols { height: 400px; gap: .6rem; }
    .col--b { padding-top: 1.6rem; }
    .col__set { gap: .6rem; padding-bottom: .6rem; }
    .pcard { border-radius: 18px; }
    /* .pcard__tools { top: .45rem; right: .45rem; gap: .3rem; } */
    /* .icon-btn { width: 28px; height: 28px; font-size: .85rem; } */
    .pcard__tools { display: none; }
    .pcard__label { left: .45rem; bottom: .45rem; max-width: calc(100% - .9rem); padding: .28rem .6rem; border-radius: 12px; font-size: .72rem; line-height: 1.2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fl, .curve { animation: none; }
    .col__track { animation: none; }
    .cols { overflow-y: auto; }
    .shot { transition-duration: .01s; }
  }
</style>

<script>
  (function () {
    var el = document.querySelector('.typewriter');
    if (!(el instanceof HTMLElement) || !matchMedia('(min-width: 861px) and (prefers-reduced-motion: no-preference)').matches) return;
    var words = JSON.parse(el.dataset.words ?? '[]'), w = 0, n = el.textContent?.length ?? 0, dir = 1;
    if (words.length < 2) return;
    setInterval(function () {
      var word = words[w];
      n += dir;
      el.textContent = word.slice(0, n);
      if (n >= word.length + 8) dir = -1;
      if (n <= 0) { dir = 1; w = (w + 1) % words.length; }
    }, 90);
  })();

  function loadNearViewport(target: Element, load: () => void) {
    if (!('IntersectionObserver' in window)) { load(); return; }
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      load();
    }, { rootMargin: '200px 0px' });
    observer.observe(target);
  }

  function mountImage(template: HTMLTemplateElement | null) {
    const image = template?.content.querySelector('img');
    if (template && image) template.replaceWith(image);
    return image;
  }

  // Bring in each gallery image when it is first shown.
  (function () {
    const root = document.querySelector('[data-shots]');
    if (!root) return;
    const shots = [...root.querySelectorAll('.shot')];
    const dots = [...root.querySelectorAll('.dot')];
    if (!shots.length) return;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let selection = 0;
    let timer: number | undefined;
    let visible = false;
    let hovered = false;

    function getImage(shot: Element) {
      return shot.querySelector('img') ?? mountImage(shot.querySelector('template'));
    }

    async function show(index: number) {
      const request = ++selection;
      const image = getImage(shots[index]);
      try { await image?.decode(); } catch { /* The slide's background remains usable. */ }
      if (request !== selection) return;
      current = index;
      shots.forEach((shot, i) => {
        shot.classList.toggle('is-on', i === current);
        shot.setAttribute('aria-hidden', String(i !== current));
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-on', i === current);
        dot.setAttribute('aria-current', String(i === current));
      });
    }

    function schedule() {
      window.clearTimeout(timer);
      if (!visible || hovered || reduceMotion.matches || shots.length < 2) return;
      timer = window.setTimeout(async () => {
        await show((current + 1) % shots.length);
        schedule();
      }, 4500);
    }

    loadNearViewport(root, () => getImage(shots[current]));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        schedule();
      }).observe(root);
    } else {
      visible = true;
      schedule();
    }
    dots.forEach((dot, i) => dot.addEventListener('click', async () => {
      window.clearTimeout(timer);
      await show(i);
      schedule();
    }));
    root.addEventListener('mouseenter', () => { hovered = true; schedule(); });
    root.addEventListener('mouseleave', () => { hovered = false; schedule(); });
    reduceMotion.addEventListener('change', schedule);
  })();

  // Video: big play button swaps in an inline player
  (function () {
    var box = document.querySelector('[data-video]');
    if (!box) return;
    loadNearViewport(box, () => {
      if (!box.classList.contains('is-playing')) mountImage(box.querySelector('[data-video-poster]'));
    });
    var src = box.dataset.src;
    var button = box.querySelector('.play');
    button.addEventListener('click', function () {
      if (!src) return;
      var v = document.createElement('video');
      v.src = src; v.controls = true; v.playsInline = true;
      v.setAttribute('aria-label', button.getAttribute('aria-label') || '');
      box.appendChild(v); box.classList.add('is-playing');
      // Start within the button's user gesture, including on Safari with audio.
      v.play().catch(() => v.focus());
    });
  })();

  // Takeaways rail: endless auto-scroll, pause on hover/focus, drag + arrows
  (function () {
    var vp = document.querySelector('[data-rail]');
    if (!vp) return;
    var track = vp.querySelector('.rail__track');
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var pos = 0, paused = false, hold = 0, last = 0, speed = 0.045; // px per ms
    var drag = false, sx = 0, sl = 0;
    let frame = 0;
    function half() { return track.scrollWidth / 2; }
    function wrap() { var h = half(); if (pos >= h) pos -= h; else if (pos <= 0) pos += h; }
    function tick(t) {
      var dt = Math.min(t - last, 50); last = t;
      if (Math.abs(vp.scrollLeft - pos) > 2 || drag || t < hold) pos = vp.scrollLeft;
      else if (!paused && !reduce) pos += speed * dt;
      wrap();
      if (Math.abs(vp.scrollLeft - pos) > 0.5) vp.scrollLeft = pos;
      frame = requestAnimationFrame(tick);
    }
    vp.addEventListener('mouseenter', function () { paused = true; });
    vp.addEventListener('mouseleave', function () { paused = false; });
    vp.addEventListener('focusin', function () { paused = true; });
    vp.addEventListener('focusout', function () { paused = false; });
    vp.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      drag = true; sx = e.clientX; sl = vp.scrollLeft; vp.classList.add('is-drag');
    });
    window.addEventListener('pointermove', function (e) { if (drag) vp.scrollLeft = sl - (e.clientX - sx); });
    window.addEventListener('pointerup', function () { drag = false; vp.classList.remove('is-drag'); });
    vp.addEventListener('touchstart', function () { paused = true; }, { passive: true });
    vp.addEventListener('touchend', function () { setTimeout(function () { paused = false; }, 1500); }, { passive: true });
    document.querySelectorAll('.arrow').forEach(function (a) {
      a.addEventListener('click', function () {
        hold = performance.now() + 700;
        vp.scrollBy({ left: +a.dataset.dir * 364, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
    if (!reduce && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !frame) {
          pos = vp.scrollLeft;
          frame = requestAnimationFrame(t => { last = t; tick(t); });
        } else if (!entry.isIntersecting) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      });
      observer.observe(vp);
    }
  })();

  // CTA photo cards: heart toggle
  (function () {
    var cols = document.querySelector('[data-cols]');
    if (!cols) return;
    cols.addEventListener('click', function (e) {
      var h = e.target.closest('.heart');
      if (!h) return;
      var on = !h.classList.contains('is-on');
      h.classList.toggle('is-on', on);
      h.setAttribute('aria-pressed', on ? 'true' : 'false');
      h.textContent = on ? '♥' : '♡';
    });
  })();
</script>

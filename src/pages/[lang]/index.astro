<script is:inline>
  (function () {
    var el = document.querySelector('.typewriter');
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var words = JSON.parse(el.dataset.words), w = 0, n = 0, dir = 1;
    setInterval(function () {
      var word = words[w];
      n += dir;
      el.textContent = word.slice(0, n);
      if (n >= word.length + 8) dir = -1;
      if (n <= 0) { dir = 1; w = (w + 1) % words.length; }
    }, 90);
  })();
</script>

<script is:inline>
  // Intro photos: crossfade + dots
  (function () {
    var root = document.querySelector('[data-shots]');
    if (!root) return;
    var shots = root.querySelectorAll('.shot'), dots = root.querySelectorAll('.dot'), i = 0, timer;
    function show(n) {
      i = (n + shots.length) % shots.length;
      shots.forEach(function (s, k) { s.classList.toggle('is-on', k === i); });
      dots.forEach(function (d, k) { d.classList.toggle('is-on', k === i); });
    }
    function start() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop(); timer = setInterval(function () { show(i + 1); }, 4500);
    }
    function stop() { clearInterval(timer); }
    dots.forEach(function (d) { d.addEventListener('click', function () { show(+d.dataset.i); start(); }); });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
  })();
</script>

<script is:inline>
  // Video: big play button swaps in an inline player
  (function () {
    var box = document.querySelector('[data-video]');
    if (!box) return;
    var src = box.dataset.src;
    box.querySelector('.play').addEventListener('click', function () {
      if (!src) return;
      var v = document.createElement('video');
      v.src = src; v.controls = true; v.autoplay = true; v.playsInline = true;
      box.appendChild(v); box.classList.add('is-playing');
    });
  })();
</script>

<script is:inline>
  // Takeaways rail: endless auto-scroll, pause on hover/focus, drag + arrows
  (function () {
    var vp = document.querySelector('[data-rail]');
    if (!vp) return;
    var track = vp.querySelector('.rail__track');
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var pos = 0, paused = false, hold = 0, last = 0, speed = 0.045; // px per ms
    var drag = false, sx = 0, sl = 0;
    function half() { return track.scrollWidth / 2; }
    function wrap() { var h = half(); if (pos >= h) pos -= h; else if (pos <= 0) pos += h; }
    function tick(t) {
      var dt = Math.min(t - last, 50); last = t;
      if (Math.abs(vp.scrollLeft - pos) > 2 || drag || t < hold) pos = vp.scrollLeft;
      else if (!paused && !reduce) pos += speed * dt;
      wrap();
      if (Math.abs(vp.scrollLeft - pos) > 0.5) vp.scrollLeft = pos;
      requestAnimationFrame(tick);
    }
    vp.addEventListener('mouseenter', function () { paused = true; });
    vp.addEventListener('mouseleave', function () { paused = false; });
    vp.addEventListener('focusin', function () { paused = true; });
    vp.addEventListener('focusout', function () { paused = false; });
    vp.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      drag = true; sx = e.clientX; sl = vp.scrollLeft; vp.classList.add('is-drag');
    });
    window.addEventListener('pointermove', function (e) { if (drag) vp.scrollLeft = sl - (e.clientX - sx); });
    window.addEventListener('pointerup', function () { drag = false; vp.classList.remove('is-drag'); });
    vp.addEventListener('touchstart', function () { paused = true; }, { passive: true });
    vp.addEventListener('touchend', function () { setTimeout(function () { paused = false; }, 1500); }, { passive: true });
    document.querySelectorAll('.arrow').forEach(function (a) {
      a.addEventListener('click', function () {
        hold = performance.now() + 700;
        vp.scrollBy({ left: +a.dataset.dir * 364, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
    requestAnimationFrame(function (t) { last = t; pos = half() / 2; vp.scrollLeft = pos; requestAnimationFrame(tick); });
  })();
</script>

<script is:inline>
  // CTA cards: swing in once, flip on click, glossy highlight follows cursor
  (function () {
    var row = document.querySelector('[data-hangers]');
    if (!row) return;
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (en) {
        if (en[0].isIntersecting) { row.classList.add('in'); io.disconnect(); }
      }, { threshold: 0.3 });
      io.observe(row);
    } else { row.classList.add('in'); }
    // every card swings its own way: random start angle, speed, delay and reach
    function rnd(a, b) { return a + Math.random() * (b - a); }
    row.querySelectorAll('.hang').forEach(function (h) {
      var st = h.style;
      st.setProperty('--a0', ((Math.random() < 0.5 ? -1 : 1) * rnd(6, 15)).toFixed(1));
      st.setProperty('--sw', rnd(1.6, 3).toFixed(2) + 's');
      st.setProperty('--dl', rnd(0, 0.9).toFixed(2) + 's');
      st.setProperty('--dur', rnd(4.2, 8.5).toFixed(2) + 's');
      st.setProperty('--hi', rnd(0.8, 3.6).toFixed(1));
      st.setProperty('--lo', (-rnd(0.8, 3.6)).toFixed(1));
    });
    row.querySelectorAll('.flip').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var on = btn.classList.toggle('is-flipped');
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      var back = btn.querySelector('.face--back');
      btn.addEventListener('pointermove', function (e) {
        var r = back.getBoundingClientRect();
        // the back face is mirrored, so flip x
        var x = btn.classList.contains('is-flipped') ? r.right - e.clientX : e.clientX - r.left;
        back.style.setProperty('--mx', x + 'px');
        back.style.setProperty('--my', (e.clientY - r.top) + 'px');
        back.style.backgroundPosition = (x / r.width * 100) + '% ' + ((e.clientY - r.top) / r.height * 100) + '%';
      });
    });
  })();
</script>
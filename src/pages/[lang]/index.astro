  .face__label { position: relative; margin-top: auto; display: flex; align-items: center; gap: .5rem; padding: 2.4rem 1.1rem 1.1rem; text-align: left; font: 700 1.1rem / 1.2 var(--font-display); color: #fff; background: linear-gradient(to top, rgba(8, 20, 60, .85), transparent); }
  .face--back { transform: rotateY(180deg); justify-content: center; align-items: center; gap: .7rem; padding: 1.6rem 1.3rem; text-align: center; color: #fff;
    background: linear-gradient(135deg, var(--tc) 0%, #1E4FA3 55%, #7A5CD6 100%); background-size: 160% 160%; }
  .face--back strong { font: 700 1.25rem / 1.25 var(--font-display); }
  .face--back span { font-size: var(--fs-sm); line-height: 1.5; opacity: .95; }
  /* glossy sheen that follows the cursor */
  .face--back::before { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle 190px at var(--mx, 30%) var(--my, 20%), rgba(255,255,255,.65), rgba(255,255,255,0) 70%); mix-blend-mode: soft-light; opacity: .9; }
  .face--back::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: linear-gradient(115deg, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 38%, rgba(255,255,255,0) 62%, rgba(255,255,255,.18) 100%);
    box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.45), inset 0 18px 30px rgba(255,255,255,.18); }
  .face--back > * { position: relative; z-index: 1; }

  @media (max-width: 1279px) {
    .curve--a, .curve--b { display: none; }
  }
  @media (max-width: 1000px) {

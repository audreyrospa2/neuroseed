---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import PhotoSwitcher from '../../components/PhotoSwitcher.astro';
import Partners from '../../components/Partners.astro';
import { t, type Lang } from '../../i18n/utils';
import home from '../../content/pages/home.json';
import brainy from '../../content/pages/brainy.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = home[lang];
const b = brainy[lang];
const counters = b.impact.stats.map((x) => {
  const m = x.n.match(/^([\d.]+)(.*)$/);
  return { ...x, value: m ? m[1] : '', suffix: m ? m[2] : '', dec: m && m[1].includes('.') ? m[1].split('.')[1].length : 0 };
});
// Save the classroom photo as public/images/hero.jpg
const heroImg = '/images/hero.jpg';
const voiceImgs = ['/images/3.jpg', '/images/8.jpg'];
---
<Layout lang={lang} title={t(lang, 'nav.home')} description={c.lead}>

  <!-- 1. HERO: full-bleed blue, copy left, photo fading in from the right, floating curves -->
  <section class="hero">
    <div class="hero__curves" aria-hidden="true">
      <svg class="curve curve--a" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M12 88 C4 36 58 4 92 28 C122 50 84 100 52 76" stroke="#B9A5E8" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--b" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M14 60 C30 8 92 8 106 52 C116 84 70 112 44 94" stroke="#F08A84" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--c" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M10 96 C30 30 70 20 108 34" stroke="#F7C948" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--d" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M12 88 C4 36 58 4 92 28 C122 50 84 100 52 76" stroke="#8FB8F0" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--e" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M14 60 C30 8 92 8 106 52 C116 84 70 112 44 94" stroke="#E9A8E0" stroke-width="12" stroke-linecap="round"/></svg>
      <svg class="curve curve--f" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M12 88 C4 36 58 4 92 28 C122 50 84 100 52 76" stroke="#F7C948" stroke-width="12" stroke-linecap="round"/></svg>
    </div>
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="pill">{c.badge}</span>
        <h1>{c.title}<br /><span class="accent typewriter" data-words={JSON.stringify(c.accents)}>{c.accents[0]}</span></h1>
        <p class="sub">{c.sub}</p>
        <p class="lead">{c.lead}</p>
        <div class="actions">
          <a class="btn btn--sun" href={`/${lang}/about/`}>{c.learn} <span aria-hidden="true">→</span></a>
          <a class="watch" href="#video"><span class="watch__ring" aria-hidden="true">▶</span>{c.watch}</a>
        </div>
        <p class="proof">{c.proof}</p>
      </div>
    </div>
    <div class="hero__photo">
      <img src={heroImg} alt="" onerror="this.style.display='none'" />
    </div>
  </section>

  <!-- 2. PROBLEM: centred head, three equal cards, centred question -->
  <section class="section section--tint">
    <div class="container">
      <header class="head">
        <p class="speech">{b.pain.bubble}</p>
        <h2>{b.pain.h}</h2>
      </header>
      <ul class="grid grid--3">
        {b.pain.tags.map((x) => <li class="pain-card">{x}</li>)}
      </ul>
      <p class="closing">{b.pain.q}</p>
    </div>
  </section>

  <!-- 3. INTRO: two equal columns -->
  <section class="section">
    <div class="container two">
      <div class="two__text">
        <h2>{c.intro.h}</h2>
        <p class="muted">{c.intro.p1}</p>
        <p class="muted">{c.intro.p2}</p>
        <a class="btn" href={`/${lang}/about/`}>{c.intro.link}</a>
      </div>
      <PhotoSwitcher slides={c.intro.slides} />
    </div>
  </section>

  <!-- 4. METHOD: four equal cards (a real sequence, so numbered) -->
  <section class="section section--deep">
    <div class="container">
      <header class="head">
        <p class="kicker">{b.method.brand}</p>
        <h2>{b.method.h}</h2>
      </header>
      <ol class="grid grid--4">
        {b.method.steps.map((s, i) => (
          <li class="step" style={`--c:${s.color}`}>
            <span class="step__n">{i + 1}</span>
            <span class="step__name">{s.h}</span>
          </li>
        ))}
      </ol>
      <p class="closing">{b.method.note}</p>
    </div>
  </section>

  <!-- 5. VOICES: two equal cards -->
  <section class="section">
    <div class="container">
      <header class="head">
        <h2>{b.voices.h}</h2>
        <p class="lead">{b.voices.sub}</p>
      </header>
      <div class="grid grid--2">
        {b.voices.items.map((v, i) => (
          <figure class="voice">
            <Photo label={v.school} src={voiceImgs[i]} ratio="16 / 9" />
            <blockquote>{v.quote}</blockquote>
            <figcaption><strong>{v.school}</strong><br />{v.who}</figcaption>
            <p class="count"><span>{v.count}</span>{v.label}</p>
          </figure>
        ))}
      </div>
      <p class="closing">{b.voices.foot}</p>
    </div>
  </section>

  <!-- 6. IMPACT: centred stats, 3 + 2 -->
  <section class="section section--brand">
    <div class="container">
      <header class="head">
        <h2>{b.impact.h}</h2>
        <p class="head__sub">{b.impact.sub}</p>
      </header>
      <ul class="stats">
        {counters.map((s) => (
          <li class="stat">
            <span class="stat__num">
              <i class="stat__blob" aria-hidden="true"></i>
              <strong data-count={s.value} data-dec={s.dec} data-suffix={s.suffix}>{s.n}</strong>
            </span>
            <span class="stat__label">{s.l}</span>
          </li>
        ))}
      </ul>
      <p class="closing closing--light">{b.impact.close}</p>
    </div>
  </section>

  <!-- 7. VIDEO -->
  <section class="section container" id="video">
    <header class="head"><h2>{c.video.h}</h2></header>
    <div class="video">
      {c.video.src ? (
        <video controls playsinline preload="metadata" poster={c.video.poster || undefined} src={c.video.src}></video>
      ) : (
        <div class="video-ph">
          {c.video.poster && <img src={c.video.poster} alt="" />}
          <span class="play" aria-hidden="true">▶</span>
          <small>{c.video.note}</small>
        </div>
      )}
    </div>
  </section>

  <!-- 8. TAKEAWAYS: four equal cards -->
  <section class="section section--tint">
    <div class="container">
      <header class="head"><h2>{c.takeaways.h}</h2></header>
      <ul class="grid grid--4">
        {c.takeaways.items.map((x, i) => (
          <li class="card take">
            <span class="num">{i + 1}</span>
            <h3>{x.h}</h3>
            <p class="muted">{x.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. CONTACT: fully centred -->
  <section class="section section--grad contact" id="contact">
    <div class="container">
      <header class="head"><h2>{b.contact.h}</h2></header>
      <ul class="ribbon">
        {b.contact.steps.map((s) => <li>{s}</li>)}
      </ul>
      <p class="contact__ask">{b.contact.ask}</p>
      <div class="contact__who">
        <strong>{b.contact.label}</strong>
        <a href={`mailto:${b.contact.email}`}>{b.contact.email}</a>
        <a href={`https://${b.contact.site}`} rel="noopener">{b.contact.site}</a>
      </div>
      <a class="btn btn--sun" href={`/${lang}/book-a-training/`}>{t(lang, 'cta.book')}</a>
    </div>
  </section>

  <!-- 10. PARTNERS -->
  <Partners lang={lang} />
</Layout>

<style>
  /* Shared rhythm: every section = same vertical padding, centred head, same gaps */
  .head { text-align: center; max-width: 46rem; margin: 0 auto 2.8rem; }
  .head h2 { text-wrap: balance; }
  .head .lead, .head__sub { margin: 1rem auto 0; }
  .head__sub { opacity: 0.9; }
  .kicker { font-weight: 700; margin-bottom: 0.6rem; color: var(--sun); }
  .closing { text-align: center; font: 600 var(--fs-lg) / 1.5 var(--font-display); max-width: 36rem; margin: 2.8rem auto 0; text-wrap: balance; }
  .closing--light { color: inherit; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .grid--2 { grid-template-columns: repeat(2, 1fr); }
  .grid--3 { grid-template-columns: repeat(3, 1fr); }
  .grid--4 { grid-template-columns: repeat(4, 1fr); }

  /* 1 Hero */
  .hero { position: relative; overflow: hidden; isolation: isolate; color: #fff; min-height: min(86vh, 720px); display: flex; align-items: center;
    background: radial-gradient(120% 120% at 15% 10%, #2A63C2 0%, var(--brand) 45%, var(--brand-deep) 100%); }
  .hero__grid { position: relative; z-index: 2; padding-block: 4rem; }
  .hero__text { max-width: 560px; }
  .hero .pill { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.3); color: #fff; }
  .hero h1 { margin: 1.2rem 0 0.9rem; text-wrap: balance; color: #fff; }
  .hero .accent { color: var(--sun); background: none; }
  .hero .typewriter::after { color: var(--sun); }
  .hero .sub { font-weight: 700; color: #fff; margin-bottom: 0.6rem; }
  .hero .lead { color: rgba(255,255,255,0.88); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; margin: 1.8rem 0 1.4rem; }
  .hero .btn--sun { font-weight: 700; min-height: 54px; padding-inline: 1.8rem; box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
  .watch { display: inline-flex; align-items: center; gap: 0.8rem; color: #fff; text-decoration: none; font-weight: 500; }
  .watch__ring { width: 54px; height: 54px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.7); display: grid; place-items: center; font-size: 0.9rem; transition: background 0.2s; }
  .watch:hover .watch__ring { background: rgba(255,255,255,0.16); }
  .proof { font-size: var(--fs-sm); color: rgba(255,255,255,0.75); max-width: 46ch; }
  .hero__photo { position: absolute; z-index: 1; top: 0; right: 0; bottom: 0; width: 56%;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 34%); mask-image: linear-gradient(to right, transparent 0, #000 34%); }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 40% center; }
  .typewriter::after { content: '|'; margin-left: 2px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* floating colourful curves */
  .hero__curves { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .curve { position: absolute; width: var(--s, 90px); height: var(--s, 90px); opacity: 0.9; rotate: var(--r, 0deg); animation: float var(--t, 7s) ease-in-out var(--dl, 0s) infinite; }
  .curve--a { --s: 90px;  --r: -20deg; --t: 7s;   top: 2%;    left: 1%; }
  .curve--b { --s: 110px; --r: 25deg;  --t: 8.5s; --dl: -2s;  top: 52%;  left: -2%; }
  .curve--c { --s: 120px; --r: 0deg;   --t: 6.5s; --dl: -1s;  bottom: 4%; left: 30%; }
  .curve--d { --s: 130px; --r: 200deg; --t: 9s;   --dl: -3s;  top: 6%;   left: 44%; }
  .curve--e { --s: 100px; --r: -35deg; --t: 7.5s; --dl: -4s;  top: 14%;  right: 2%; }
  .curve--f { --s: 120px; --r: 160deg; --t: 8s;   --dl: -2.5s; bottom: 3%; right: 3%; }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -16px; } }

  /* 2 Pain */
  .speech {
    display: inline-block; margin: 0 0 1.2rem; padding: 0.7rem 1.6rem;
    background: var(--coral); color: var(--on-coral);
    font: 700 1.25rem / 1.2 var(--font-display); border-radius: 999px;
  }
  .pain-card {
    display: grid; place-items: center; text-align: center; min-height: 120px; padding: 1.5rem;
    background: var(--surface); border: 0; border-top: 6px solid var(--brand); border-radius: var(--radius-md);
    box-shadow: 0 10px 28px rgba(30, 79, 163, 0.12);
    font: 700 1.25rem / 1.35 var(--font-display); color: var(--brand-deep);
  }

  /* 3 Intro */
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .two__text h2 { margin-bottom: 1rem; text-wrap: balance; }
  .two__text .btn { margin-top: 0.6rem; }

  /* 4 Method */
  .step {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
    min-height: 200px; padding: 1.8rem 1rem; text-align: center;
    background: var(--c); color: #fff; border-radius: var(--radius-md);
  }
  .step:nth-child(3) { color: #3A2A2A; }
  .step__n {
    width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center;
    background: #fff; color: #1F2A44; font-weight: 700;
  }
  .step__name { font: 700 1.3rem / 1.25 var(--font-display); }

  /* 5 Voices */
  .voice { margin: 0; display: flex; flex-direction: column; gap: 1rem; padding: 1.2rem 1.2rem 1.8rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .voice blockquote { margin: 0; padding: 1.4rem 1.6rem; background: var(--brand); color: var(--on-brand); border-radius: var(--radius-sm); font: 600 1.2rem / 1.5 var(--font-display); flex: 1; }
  .voice figcaption { font-size: var(--fs-sm); color: var(--muted); padding-inline: 0.4rem; }
  .count { display: flex; align-items: baseline; gap: 0.7rem; margin: 0; padding-inline: 0.4rem; color: var(--muted); }
  .count span { font: 700 var(--fs-stat) / 1 var(--font-display); color: var(--brand); }

  /* 6 Impact: counters, centred, 3 + 2 on narrower screens */
  .stats { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 3rem 1.5rem; }
  .stat { flex: 1 1 0; min-width: 170px; display: flex; flex-direction: column; align-items: center; gap: 0.9rem; text-align: center; }
  .stat__num { position: relative; display: inline-block; padding-inline: 0.4rem; }
  .stat__num strong { position: relative; z-index: 1; display: block; font: 700 clamp(3rem, 5.4vw, 4.5rem) / 1 var(--font-display); font-variant-numeric: tabular-nums; }
  .stat__blob { position: absolute; z-index: 0; top: -0.7rem; right: -1rem; width: 2.8rem; height: 2.8rem; background: #F08A84; border-radius: 50%; }
  .stat:nth-child(2) .stat__blob { background: #A8D1E7; border-radius: 50% 50% 0 50%; }
  .stat:nth-child(3) .stat__blob { background: #F2C14E; }
  .stat:nth-child(4) .stat__blob { background: #8FD0B0; border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%; }
  .stat:nth-child(5) .stat__blob { background: #F3C9C9; border-radius: 30%; rotate: 12deg; }
  .stat__label { font-size: var(--fs-sm); line-height: 1.45; max-width: 20ch; }

  /* 7 Video */
  .video { max-width: 900px; margin-inline: auto; }
  video, .video-ph { width: 100%; aspect-ratio: 16 / 9; border-radius: var(--radius-md); background: var(--brand-deep); }
  .video-ph { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; color: #fff; text-align: center; padding: 1.5rem; }
  .video-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
  .video-ph > :not(img) { position: relative; }
  .play { width: 84px; height: 84px; border-radius: 50%; background: var(--sun); color: #1B1B18; display: grid; place-items: center; font-size: 1.8rem; }

  /* 8 Takeaways */
  .take { border-top: 5px solid var(--brand); display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1.8rem 1.4rem; }
  .num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 700; margin-bottom: 1rem; }
  .take h3 { margin-bottom: 0.6rem; }
  .take p { margin: 0; }

  /* 9 Contact */
  .contact .container { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.6rem; }
  .contact .head { margin-bottom: 0; }
  .ribbon { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
  .ribbon li { background: var(--sun); color: #1B1B18; padding: 0.7rem 1.6rem; border-radius: 999px; font: 700 1.2rem / 1.2 var(--font-display); }
  .contact__ask { font: 500 var(--fs-lg) / 1.5 var(--font-display); max-width: 34rem; margin: 0; text-wrap: balance; }
  .contact__who { display: grid; gap: 0.2rem; }
  .contact__who a { font-weight: 700; font-size: var(--fs-lg); color: #fff; }

  @media (max-width: 1000px) {
    .grid--4 { grid-template-columns: repeat(2, 1fr); }
    .stat { flex: 0 0 calc((100% - 3rem) / 3); }
  }
  @media (max-width: 860px) {
    .two { grid-template-columns: 1fr; }
    .hero { flex-direction: column; align-items: stretch; min-height: 0; }
    .hero__grid { padding-block: 3rem 1rem; }
    .hero__photo { position: relative; width: 100%; height: 340px; -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 30%); mask-image: linear-gradient(to bottom, transparent 0, #000 30%); }
    .curve--d, .curve--c { display: none; }
    .grid--2, .grid--3 { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .grid--4 { grid-template-columns: 1fr; }
    .stat { flex: 0 0 calc((100% - 1.5rem) / 2); }
  }
</style>

<script is:inline>
  (function () {
    var el = document.querySelector('.typewriter');
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var words = JSON.parse(el.dataset.words), w = 0, n = 0, dir = 1;
    setInterval(function () {
      var word = words[w];
      n += dir;
      el.textContent = word.slice(0, n);
      if (n >= word.length + 8) dir = -1;
      if (n <= 0) { dir = 1; w = (w + 1) % words.length; }
    }, 90);
  })();
</script>

<script is:inline>
  (function () {
    var els = document.querySelectorAll('[data-count]');
    if (!els.length || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    function run(el) {
      var end = parseFloat(el.dataset.count), dec = +el.dataset.dec || 0, suf = el.dataset.suffix || '', t0 = null, dur = 1400;
      function tick(t) {
        if (t0 === null) t0 = t;
        var p = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
        el.textContent = (end * e).toFixed(dec) + suf;
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { run(en.target); io.unobserve(en.target); } });
    }, { threshold: 0.4 });
    els.forEach(function (el) { if (!isNaN(parseFloat(el.dataset.count))) io.observe(el); });
  })();
</script>
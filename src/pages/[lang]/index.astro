---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import PhotoSwitcher from '../../components/PhotoSwitcher.astro';
import Partners from '../../components/Partners.astro';
import { t, type Lang } from '../../i18n/utils';
import home from '../../content/pages/home.json';
import brainy from '../../content/pages/brainy.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = home[lang];
const b = brainy[lang];
const counters = b.impact.stats.map((x) => {
  const m = x.n.match(/^([\d.]+)(.*)$/);
  return { ...x, value: m ? m[1] : '', suffix: m ? m[2] : '', dec: m && m[1].includes('.') ? m[1].split('.')[1].length : 0 };
});
const voiceImgs = ['/images/3.jpg', '/images/8.jpg'];
---
<Layout lang={lang} title={t(lang, 'nav.home')} description={c.lead}>

  <!-- 1. HERO: text left, 2x2 photo grid right (equal columns, equal tiles) -->
  <section class="container hero">
    <div class="hero__text">
      <span class="pill">{c.badge}</span>
      <h1>{c.title}<br /><span class="accent typewriter" data-words={JSON.stringify(c.accents)}>{c.accents[0]}</span></h1>
      <p class="sub">{c.sub}</p>
      <p class="lead">{c.lead}</p>
      <div class="actions">
        <a class="btn btn--primary" href={`/${lang}/book-a-training/`}>{t(lang, 'cta.book')}</a>
        <a class="btn" href="#video">▶ {c.watch}</a>
      </div>
      <p class="proof muted">{c.proof}</p>
    </div>
    <div class="tiles">
      {c.tiles.map((x) => <Photo label={x.label} color={x.color} icon={x.icon} src={x.img} ratio="1 / 1" />)}
    </div>
  </section>

  <!-- 2. PROBLEM: centred head, three equal cards, centred question -->
  <section class="section section--tint">
    <div class="container">
      <header class="head">
        <p class="speech">{b.pain.bubble}</p>
        <h2>{b.pain.h}</h2>
      </header>
      <ul class="grid grid--3">
        {b.pain.tags.map((x) => <li class="pain-card">{x}</li>)}
      </ul>
      <p class="closing">{b.pain.q}</p>
    </div>
  </section>

  <!-- 3. INTRO: two equal columns -->
  <section class="section">
    <div class="container two">
      <div class="two__text">
        <h2>{c.intro.h}</h2>
        <p class="muted">{c.intro.p1}</p>
        <p class="muted">{c.intro.p2}</p>
        <a class="btn" href={`/${lang}/about/`}>{c.intro.link}</a>
      </div>
      <PhotoSwitcher slides={c.intro.slides} />
    </div>
  </section>

  <!-- 4. METHOD: four equal cards (a real sequence, so numbered) -->
  <section class="section section--sky">
    <div class="container">
      <header class="head">
        <p class="kicker">{b.method.brand}</p>
        <h2>{b.method.h}</h2>
      </header>
      <ol class="grid grid--4">
        {b.method.steps.map((s, i) => (
          <li class="step" style={`--c:${s.color}`}>
            <span class="step__n">{i + 1}</span>
            <span class="step__name">{s.h}</span>
          </li>
        ))}
      </ol>
      <p class="closing">{b.method.note}</p>
    </div>
  </section>

  <!-- 5. VOICES: two equal cards -->
  <section class="section">
    <div class="container">
      <header class="head">
        <h2>{b.voices.h}</h2>
        <p class="lead">{b.voices.sub}</p>
      </header>
      <div class="grid grid--2">
        {b.voices.items.map((v, i) => (
          <figure class="voice">
            <Photo label={v.school} src={voiceImgs[i]} ratio="16 / 9" />
            <blockquote>{v.quote}</blockquote>
            <figcaption><strong>{v.school}</strong><br />{v.who}</figcaption>
            <p class="count"><span>{v.count}</span>{v.label}</p>
          </figure>
        ))}
      </div>
      <p class="closing">{b.voices.foot}</p>
    </div>
  </section>

  <!-- 6. IMPACT: centred stats, 3 + 2 -->
  <section class="section section--brand">
    <div class="container">
      <header class="head">
        <h2>{b.impact.h}</h2>
        <p class="head__sub">{b.impact.sub}</p>
      </header>
      <ul class="stats">
        {counters.map((s) => (
          <li class="stat">
            <span class="stat__num">
              <i class="stat__blob" aria-hidden="true"></i>
              <strong data-count={s.value} data-dec={s.dec} data-suffix={s.suffix}>{s.n}</strong>
            </span>
            <span class="stat__label">{s.l}</span>
          </li>
        ))}
      </ul>
      <p class="closing closing--light">{b.impact.close}</p>
    </div>
  </section>

  <!-- 7. VIDEO -->
  <section class="section container" id="video">
    <header class="head"><h2>{c.video.h}</h2></header>
    <div class="video">
      {c.video.src ? (
        <video controls playsinline preload="metadata" poster={c.video.poster || undefined} src={c.video.src}></video>
      ) : (
        <div class="video-ph">
          {c.video.poster && <img src={c.video.poster} alt="" />}
          <span class="play" aria-hidden="true">▶</span>
          <small>{c.video.note}</small>
        </div>
      )}
    </div>
  </section>

  <!-- 8. TAKEAWAYS: four equal cards -->
  <section class="section section--tint">
    <div class="container">
      <header class="head"><h2>{c.takeaways.h}</h2></header>
      <ul class="grid grid--4">
        {c.takeaways.items.map((x, i) => (
          <li class="card take">
            <span class="num">{i + 1}</span>
            <h3>{x.h}</h3>
            <p class="muted">{x.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. CONTACT: fully centred -->
  <section class="section section--sky contact" id="contact">
    <div class="container">
      <header class="head"><h2>{b.contact.h}</h2></header>
      <ul class="ribbon">
        {b.contact.steps.map((s) => <li>{s}</li>)}
      </ul>
      <p class="contact__ask">{b.contact.ask}</p>
      <div class="contact__who">
        <strong>{b.contact.label}</strong>
        <a href={`mailto:${b.contact.email}`}>{b.contact.email}</a>
        <a href={`https://${b.contact.site}`} rel="noopener">{b.contact.site}</a>
      </div>
      <a class="btn btn--primary" href={`/${lang}/book-a-training/`}>{t(lang, 'cta.book')}</a>
    </div>
  </section>

  <!-- 10. PARTNERS -->
  <Partners lang={lang} />
</Layout>

<style>
  /* Shared rhythm: every section = same vertical padding, centred head, same gaps */
  .head { text-align: center; max-width: 46rem; margin: 0 auto 2.8rem; }
  .head h2 { text-wrap: balance; }
  .head .lead, .head__sub { margin: 1rem auto 0; }
  .head__sub { opacity: 0.9; }
  .kicker { font-weight: 700; margin-bottom: 0.6rem; }
  .closing { text-align: center; font: 600 var(--fs-lg) / 1.5 var(--font-display); max-width: 36rem; margin: 2.8rem auto 0; text-wrap: balance; }
  .closing--light { color: inherit; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .grid--2 { grid-template-columns: repeat(2, 1fr); }
  .grid--3 { grid-template-columns: repeat(3, 1fr); }
  .grid--4 { grid-template-columns: repeat(4, 1fr); }

  /* 1 Hero */
  .hero { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; padding-block: 4.5rem; }
  .hero h1 { margin: 1.2rem 0 0.8rem; text-wrap: balance; }
  .sub { font-weight: 700; color: var(--muted); margin-bottom: 0.8rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin: 1.8rem 0 1.4rem; }
  .proof { font-size: var(--fs-sm); max-width: 46ch; }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .typewriter::after { content: '|'; margin-left: 2px; color: var(--coral); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* 2 Pain */
  .speech {
    display: inline-block; margin: 0 0 1.2rem; padding: 0.7rem 1.6rem;
    background: var(--coral); color: var(--on-coral);
    font: 700 1.25rem / 1.2 var(--font-display); border-radius: 999px;
  }
  .pain-card {
    display: grid; place-items: center; text-align: center; min-height: 120px; padding: 1.5rem;
    background: var(--surface); border: 2px solid var(--coral); border-radius: var(--radius-md);
    font: 700 1.25rem / 1.35 var(--font-display); color: var(--ink);
  }

  /* 3 Intro */
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .two__text h2 { margin-bottom: 1rem; text-wrap: balance; }
  .two__text .btn { margin-top: 0.6rem; }

  /* 4 Method */
  .step {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
    min-height: 200px; padding: 1.8rem 1rem; text-align: center;
    background: var(--c); color: #fff; border-radius: var(--radius-md);
  }
  .step:nth-child(3) { color: #3A2A2A; }
  .step__n {
    width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center;
    background: #fff; color: #1F2A44; font-weight: 700;
  }
  .step__name { font: 700 1.3rem / 1.25 var(--font-display); }

  /* 5 Voices */
  .voice { margin: 0; display: flex; flex-direction: column; gap: 1rem; padding: 1.2rem 1.2rem 1.8rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .voice blockquote { margin: 0; padding: 1.4rem 1.6rem; background: var(--leaf); color: var(--on-leaf); border-radius: var(--radius-sm); font: 600 1.2rem / 1.5 var(--font-display); flex: 1; }
  .voice figcaption { font-size: var(--fs-sm); color: var(--muted); padding-inline: 0.4rem; }
  .count { display: flex; align-items: baseline; gap: 0.7rem; margin: 0; padding-inline: 0.4rem; color: var(--muted); }
  .count span { font: 700 var(--fs-stat) / 1 var(--font-display); color: var(--coral); }

  /* 6 Impact: counters, centred, 3 + 2 on narrower screens */
  .stats { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 3rem 1.5rem; }
  .stat { flex: 1 1 0; min-width: 170px; display: flex; flex-direction: column; align-items: center; gap: 0.9rem; text-align: center; }
  .stat__num { position: relative; display: inline-block; padding-inline: 0.4rem; }
  .stat__num strong { position: relative; z-index: 1; display: block; font: 700 clamp(3rem, 5.4vw, 4.5rem) / 1 var(--font-display); font-variant-numeric: tabular-nums; }
  .stat__blob { position: absolute; z-index: 0; top: -0.7rem; right: -1rem; width: 2.8rem; height: 2.8rem; background: #F08A84; border-radius: 50%; }
  .stat:nth-child(2) .stat__blob { background: #A8D1E7; border-radius: 50% 50% 0 50%; }
  .stat:nth-child(3) .stat__blob { background: #F2C14E; }
  .stat:nth-child(4) .stat__blob { background: #8FD0B0; border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%; }
  .stat:nth-child(5) .stat__blob { background: #F3C9C9; border-radius: 30%; rotate: 12deg; }
  .stat__label { font-size: var(--fs-sm); line-height: 1.45; max-width: 20ch; }

  /* 7 Video */
  .video { max-width: 900px; margin-inline: auto; }
  video, .video-ph { width: 100%; aspect-ratio: 16 / 9; border-radius: var(--radius-md); background: #2B2750; }
  .video-ph { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; color: #fff; text-align: center; padding: 1.5rem; }
  .video-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
  .video-ph > :not(img) { position: relative; }
  .play { width: 84px; height: 84px; border-radius: 50%; background: var(--coral); color: #fff; display: grid; place-items: center; font-size: 1.8rem; }

  /* 8 Takeaways */
  .take { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1.8rem 1.4rem; }
  .num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--coral); color: #fff; font-weight: 700; margin-bottom: 1rem; }
  .take h3 { margin-bottom: 0.6rem; }
  .take p { margin: 0; }

  /* 9 Contact */
  .contact .container { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.6rem; }
  .contact .head { margin-bottom: 0; }
  .ribbon { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
  .ribbon li { background: var(--coral); color: var(--on-coral); padding: 0.7rem 1.6rem; border-radius: 999px; font: 700 1.2rem / 1.2 var(--font-display); }
  .contact__ask { font: 500 var(--fs-lg) / 1.5 var(--font-display); max-width: 34rem; margin: 0; text-wrap: balance; }
  .contact__who { display: grid; gap: 0.2rem; }
  .contact__who a { font-weight: 700; font-size: var(--fs-lg); }

  @media (max-width: 1000px) {
    .grid--4 { grid-template-columns: repeat(2, 1fr); }
    .stat { flex: 0 0 calc((100% - 3rem) / 3); }
  }
  @media (max-width: 860px) {
    .hero, .two { grid-template-columns: 1fr; }
    .grid--2, .grid--3 { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .grid--4 { grid-template-columns: 1fr; }
    .stat { flex: 0 0 calc((100% - 1.5rem) / 2); }
  }
</style>

<script is:inline>
  (function () {
    var el = document.querySelector('.typewriter');
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var words = JSON.parse(el.dataset.words), w = 0, n = 0, dir = 1;
    setInterval(function () {
      var word = words[w];
      n += dir;
      el.textContent = word.slice(0, n);
      if (n >= word.length + 8) dir = -1;
      if (n <= 0) { dir = 1; w = (w + 1) % words.length; }
    }, 90);
  })();
</script>

<script is:inline>
  (function () {
    var els = document.querySelectorAll('[data-count]');
    if (!els.length || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    function run(el) {
      var end = parseFloat(el.dataset.count), dec = +el.dataset.dec || 0, suf = el.dataset.suffix || '', t0 = null, dur = 1400;
      function tick(t) {
        if (t0 === null) t0 = t;
        var p = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
        el.textContent = (end * e).toFixed(dec) + suf;
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { run(en.target); io.unobserve(en.target); } });
    }, { threshold: 0.4 });
    els.forEach(function (el) { if (!isNaN(parseFloat(el.dataset.count))) io.observe(el); });
  })();
</script>
---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Partners from '../../components/Partners.astro';
import { t, type Lang } from '../../i18n/utils';
import book from '../../content/pages/book.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = book[lang];
const f = c.form.fields;

// Where the form is sent. Set PUBLIC_BOOKING_ENDPOINT in .env (e.g. your Worker URL).
// If it is empty, the form falls back to opening a ready-to-send email.
const endpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
const mailTo = c.next.email;
---
<Layout lang={lang} title={t(lang, 'cta.book')} description={c.lead}>
  <PageHead eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

  <section class="section">
    <div class="container layout">

      <div class="card-form rv">
        <h2>{c.form.h}</h2>

        <noscript>
          <p>{lang === 'zh' ? '請透過電郵查詢及預約培訓。' : 'Please contact us by email to book training.'}
            <a href={`mailto:${mailTo}`}>{mailTo}</a></p>
        </noscript>
        <form class="form" method="post" inert data-form data-endpoint={endpoint} data-mail={mailTo} novalidate
          data-sending={c.form.sending} data-ok={c.form.ok} data-fail={c.form.fail} data-invalid={c.form.invalid}>

          <div class="field">
            <label for="f-name">{f.name} <span class="req" aria-hidden="true">*</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="f-org">{f.organization} <span class="req" aria-hidden="true">*</span></label>
            <input id="f-org" name="organization" type="text" autocomplete="organization" required />
          </div>

          <div class="field">
            <label for="f-pos">{f.position} <span class="opt">{c.form.optional}</span></label>
            <input id="f-pos" name="position" type="text" autocomplete="organization-title" />
          </div>

          <div class="row">
            <div class="field">
              <label for="f-phone">{f.phone} <span class="req" aria-hidden="true">*</span></label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
            </div>
            <div class="field">
              <label for="f-email">{f.email} <span class="req" aria-hidden="true">*</span></label>
              <input id="f-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="field">
            <label for="f-msg">{f.message} <span class="opt">{c.form.optional}</span></label>
            <textarea id="f-msg" name="message" rows="5" placeholder={c.form.placeholderMessage}></textarea>
          </div>

          <!-- spam trap: real people never see or fill this -->
          <div class="trap" aria-hidden="true"><label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>

          <button class="btn btn--primary submit" type="submit">{c.form.submit}</button>
          <p class="status" role="status" aria-live="polite" data-status></p>
        </form>

        <div class="done" data-done hidden>
          <span class="done__icon" aria-hidden="true">✓</span>
          <p>{c.form.ok}</p>
          <button type="button" class="btn" data-again>{c.form.again}</button>
        </div>
      </div>

      <aside class="side rv">
        <h3>{c.next.h}</h3>
        <ol class="steps">
          {c.next.steps.map((s, i) => <li><span class="n">{i + 1}</span>{s}</li>)}
        </ol>
        <p class="side__or">{c.next.contact}</p>
        <ul class="side__list">
          <li>
            <span>{c.next.emailLabel}</span>
            <a class="side__mail" href={`mailto:${mailTo}`}>{mailTo}</a>
          </li>
          <li>
            <span>{c.next.phoneLabel}</span>
            <a class="side__mail" href="https://wa.me/85295472118" target="_blank" rel="noopener">{c.next.phone}</a>
          </li>
        </ul>
      </aside>

    </div>
  </section>

  <Partners lang={lang} />
</Layout>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 2rem; align-items: start; }

  .card-form { background: var(--surface); border-radius: var(--radius-lg); padding: clamp(1.6rem, 4vw, 3rem); box-shadow: 0 16px 44px rgba(30, 79, 163, 0.14); border-top: 8px solid var(--brand); }
  .card-form h2 { margin-bottom: 1.6rem; color: var(--brand); }

  .form { display: grid; gap: 1.2rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .field { display: grid; gap: 0.45rem; min-width: 0; }
  label { font-weight: 700; color: var(--brand-deep); font-size: var(--fs-sm); }
  .req { color: var(--coral); }
  .opt { font-weight: 400; color: var(--muted); }
  input, textarea {
    width: 100%; min-height: 52px; padding: 0.8rem 1rem; font: 400 var(--fs-base) var(--font-body); color: var(--ink);
    background: var(--bg); border: 2px solid var(--line); border-radius: 14px; transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  textarea { min-height: 140px; resize: vertical; line-height: 1.55; }
  input::placeholder, textarea::placeholder { color: color-mix(in srgb, var(--muted) 65%, transparent); }
  input:hover, textarea:hover { border-color: color-mix(in srgb, var(--brand) 45%, var(--line)); }
  input:focus, textarea:focus { outline: none; border-color: var(--brand); background: #fff; box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 20%, transparent); }
  .form.was-checked input:invalid, .form.was-checked textarea:invalid { border-color: var(--coral); background: color-mix(in srgb, var(--coral) 6%, #fff); }

  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .submit { width: 100%; min-height: 56px; font-weight: 700; margin-top: 0.4rem; }
  .submit[disabled] { opacity: 0.7; cursor: progress; }
  .status { margin: 0; min-height: 1.4em; font-size: var(--fs-sm); color: var(--coral); font-weight: 600; }
  .status a { color: inherit; }

  .done { text-align: center; padding: 2rem 0; display: grid; justify-items: center; gap: 1rem; }
  .done[hidden] { display: none; }
  .done__icon { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; background: var(--leaf); color: #fff; font-size: 2.2rem; animation: pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .done p { font: 600 var(--fs-lg) / 1.5 var(--font-display); color: var(--brand-deep); max-width: 30ch; margin: 0; }
  @keyframes pop { from { transform: scale(0.3); opacity: 0; } to { transform: scale(1); opacity: 1; } }

  .side { background: radial-gradient(120% 140% at 80% 0%, #2A63C2 0%, var(--brand) 50%, var(--brand-deep) 100%); color: #fff; border-radius: var(--radius-lg); padding: clamp(1.6rem, 3vw, 2.4rem); position: sticky; top: calc(var(--header-h) + 1.2rem); }
  .side h3 { color: #fff; margin-bottom: 1.2rem; }
  .steps { list-style: none; margin: 0 0 1.6rem; padding: 0; display: grid; gap: 1rem; }
  .steps li { display: flex; gap: 0.9rem; align-items: flex-start; line-height: 1.45; }
  .n { flex: none; width: 2.1rem; height: 2.1rem; border-radius: 50%; display: grid; place-items: center; background: var(--sun); color: #1B1B18; font-weight: 700; }
  .side__or { margin: 0 0 0.2rem; opacity: 0.85; font-size: var(--fs-sm); }
  .side__mail { color: #fff; font-weight: 700; font-size: var(--fs-lg); word-break: break-all; }
  .side__list { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.9rem; }
  .side__list li { display: grid; gap: 0.15rem; }
  .side__list span { font-size: var(--fs-sm); opacity: 0.85; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 520px) {
    .row { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    var form = document.querySelector('[data-form]');
    if (!form) return;
    var status = form.querySelector('[data-status]');
    var done = document.querySelector('[data-done]');
    var btn = form.querySelector('.submit');
    var label = btn.textContent;

    function show(msg) { status.textContent = msg; }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      form.classList.add('was-checked');
      if (!form.checkValidity()) {
        show(form.dataset.invalid);
        var bad = form.querySelector(':invalid'); if (bad) bad.focus();
        return;
      }
      var data = {};
      new FormData(form).forEach(function (v, k) { data[k] = String(v).trim(); });
      if (data.website) return; // honeypot filled: silently drop
      delete data.website;
      data.page = location.href;
      data.lang = document.documentElement.lang;

      var endpoint = form.dataset.endpoint, mail = form.dataset.mail;

      // No endpoint configured yet: open a ready-to-send email instead
      if (!endpoint) {
        var body = ['Name: ' + data.name, 'School / Organization: ' + data.organization, 'Position: ' + (data.position || '-'),
                    'Phone: ' + data.phone, 'Email: ' + data.email, '', data.message || ''].join('\n');
        location.href = 'mailto:' + mail + '?subject=' + encodeURIComponent('Book a Training: ' + data.organization) + '&body=' + encodeURIComponent(body);
        return;
      }

      btn.disabled = true; btn.textContent = form.dataset.sending; show('');
      fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) { if (!r.ok) throw new Error(r.status); })
        .then(function () {
          form.hidden = true; done.hidden = false; form.reset(); form.classList.remove('was-checked');
          done.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })
        .catch(function () {
          status.replaceChildren();
          status.append(form.dataset.fail + ' ');
          var a = document.createElement('a'); a.href = 'mailto:' + mail; a.textContent = mail; status.appendChild(a);
        })
        .finally(function () { btn.disabled = false; btn.textContent = label; });
    });

    document.querySelector('[data-again]').addEventListener('click', function () {
      done.hidden = true; form.hidden = false; show('');
      form.querySelector('input').focus();
    });
    form.removeAttribute('inert');
  })();
</script>

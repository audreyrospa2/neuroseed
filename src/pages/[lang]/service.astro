---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Photo from '../../components/Photo.astro';
import Partners from '../../components/Partners.astro';
import { t, type Lang } from '../../i18n/utils';
import service from '../../content/pages/service.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = service[lang];
const other = service[lang === 'zh' ? 'en' : 'zh']; // used for the bilingual banner
const { tic, cos } = c.theory;
---
<Layout lang={lang} title={t(lang, 'nav.service')} description={c.lead}>
  <PageHead eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

  <!-- 1. THE CHALLENGE: banner + auto-scrolling pain cards + 4-icon strip -->
  <section class="section section--tint">
    <div class="container">
      <div class="chal">
        <header class="chal__copy">
          <p class="kicker">{c.challenge.kicker}</p>
          <h2>{c.challenge.h}</h2>
          <p class="lead">{c.challenge.lead}</p>
        </header>
        <div class="chal__photo">
          <Photo label={c.challenge.h} src={c.challenge.photo} color="#1E4FA3" icon="🧠" ratio="4 / 3" />
        </div>
      </div>

      <div class="cx" data-cx>
        <button class="cx__nav" type="button" data-prev aria-label={c.challenge.prev}>‹</button>
        <div class="cx__track" tabindex="0" role="region" aria-label={c.challenge.h}>
          {c.challenge.pains.map((x, i) => (
            <article class="cx__item pain" style={`--c:var(--brand); --tilt:${i % 2 ? 1.2 : -1.2}deg`}>
              <Photo label={x.h} src={x.img} color="#1E4FA3" icon="💬" ratio="4 / 3" />
              <h3 class="pain__tag">{x.h}</h3>
              <p>{x.sub}</p>
            </article>
          ))}
        </div>
        <button class="cx__nav" type="button" data-next aria-label={c.challenge.next}>›</button>
      </div>
      <div class="cx__dots" data-dots aria-hidden="true"></div>

      <div class="strip">
        <p class="strip__belief">{c.challenge.belief}</p>
        <ul class="strip__list">
          {c.challenge.items.map((x) => (
            <li>
              <span class="strip__icon" aria-hidden="true">{x.icon}</span>
              <strong>{x.h}</strong>
              <small>{x.sub}</small>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. FOUR STEPS: banner, training highlight, pedestal tabs, detail panel -->
  <section class="section section--deep">
    <div class="container">
      <header class="banner">
        <h2>{c.steps.h}</h2>
        <p>{other.steps.h}</p>
      </header>

      <div class="highlight">
        <p class="highlight__ribbon">{c.steps.highlight}</p>
        <div class="highlight__row">
          <div class="highlight__photo">
            <Photo label={c.steps.highlight} src={c.steps.highlightPhoto} color="#2F6FD0" icon="🎭" ratio="16 / 9" />
          </div>
          <div class="highlight__brand">
            <img src={c.steps.logo} alt={c.steps.logoAlt} onerror="this.style.display='none'" />
            <p class="highlight__tag">{c.steps.tagline}</p>
          </div>
        </div>
      </div>

      <div class="stepper" data-stepper>
        <div class="stepper__tabs" role="tablist" aria-label={c.steps.h}>
          {c.steps.items.map((s, i) => (
            <button class={`stab${s.dark ? ' stab--dark' : ''}`} type="button" role="tab" id={`tab-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${i}`} tabindex={i === 0 ? 0 : -1}
              style={`--c:${s.color}`}>
              <img class="stab__art" src={s.art} alt="" onerror="this.style.display='none'; this.nextElementSibling.hidden=false" />
              <span class="stab__icon" aria-hidden="true" hidden>{s.icon}</span>
              <span class="stab__pad">
                <span class="stab__name">{s.h}</span>
                <small>{s.sub}</small>
                <b class="stab__n">{i + 1}</b>
              </span>
            </button>
          ))}
        </div>

        <div class="stepper__bar" aria-hidden="true"><i data-bar></i></div>

        <div class="stepper__panels">
          {c.steps.items.map((s, i) => (
            <div class="spanel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
              <div class="spanel__photo"><Photo label={s.h} src={s.img} color={s.color} icon={s.icon} ratio="4 / 3" /></div>
              <div class="spanel__text">
                <span class="spanel__badge" style={`--c:${s.color}`}>{i + 1}</span>
                <h3>{s.h}</h3>
                <p class="spanel__sub">{s.sub}</p>
                <p>{s.p}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="stepper__foot">
          <button class="btn btn--sun" type="button" data-next-step data-next={c.steps.next} data-restart={c.steps.restart}>{c.steps.next} →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. THEORIES: one collage — Circle of Security on top, TIC card + booklet below -->
  <section class="section">
    <div class="container">
      <header class="head"><h2>{c.theory.h}</h2></header>

      <div class="tc">
        <div class="tc__cos">
          <div class="tc__diagram">
            <Photo label={cos.h} src={cos.img} color="#2A7D4F" icon="⭕" ratio="16 / 7" />
          </div>
          <h3>{cos.h}</h3>
          <p class="tc__sub">{cos.sub}</p>
          {cos.p.map((x) => <p class="tc__lead" set:html={x} />)}
          <div class="tc__pair">
            {cos.list.map((x) => (
              <div class="tc__chip">
                <strong>{x.h}</strong>
                <span>{x.p}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="tc__tic">
          <p class="tc__sub tc__sub--light">{tic.sub}</p>
          <h3>{tic.h}</h3>
          <p class="tc__ticp">{tic.p}</p>
          <div class="acc acc--dark">
            {tic.list.map((x) => (
              <details class="acc__item">
                <summary>{x.h}</summary>
                <p>{x.p}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="tc__book">
          <Photo label={tic.h} src={tic.img} color="#2F6FD0" icon="🛡️" ratio="1 / 1" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. CTA -->
  <section class="section section--grad cta">
    <div class="container">
      <h2>{c.cta.h}</h2>
      <p class="cta__p">{c.cta.p}</p>
      <div class="cta__row">
        <a class="btn btn--sun" href={`/${lang}/book-a-training/`}>{t(lang, 'cta.book')}</a>
        <a class="cta__mail" href={`mailto:${c.cta.email}`}>{c.cta.email}</a>
      </div>
    </div>
  </section>

  <Partners lang={lang} />
</Layout>

<style>
  .head { text-align: center; max-width: 46rem; margin: 0 auto 2.8rem; }
  .head h2 { text-wrap: balance; }
  .kicker { font-weight: 700; letter-spacing: 0.12em; margin-bottom: 0.6rem; color: var(--brand); }

  /* ---- 1 Challenge ---- */
  .chal { display: grid; grid-template-columns: 1fr 1.1fr; gap: 2.4rem; align-items: center; margin-bottom: 2rem; }
  .chal__copy h2 { text-wrap: balance; }
  .chal__copy .lead { margin-top: 1rem; }
  .chal__photo { border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 14px 34px rgba(30, 79, 163, 0.16); }

  .cx { display: flex; align-items: center; gap: 0.8rem; }
  .cx__track { --gap: 1.5rem; flex: 1; display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 1.4rem 0.4rem 1.8rem; }
  .cx__track::-webkit-scrollbar { display: none; }
  .cx__item { flex: 0 0 calc((100% - 2 * var(--gap)) / 3); scroll-snap-align: start; position: relative; overflow: hidden;
    background: var(--surface); border-radius: var(--radius-md);
    box-shadow: 0 10px 28px rgba(30, 79, 163, 0.12);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s; }
  .cx__item:hover { transform: translateY(-8px) rotate(var(--tilt)); box-shadow: 0 18px 38px rgba(30, 79, 163, 0.2); }
  .pain h3 { margin: 0; }
  .pain__tag { background: #C9463F; color: #fff; padding: 0.7rem 1rem; font-size: 1.05rem; text-wrap: balance; }
  .pain p { margin: 0; padding: 0.6rem 1rem 1.1rem; color: var(--muted); font-size: var(--fs-sm); }
  .cx__nav { flex: none; width: 48px; height: 48px; border-radius: 50%; border: 0; background: var(--brand); color: #fff; font-size: 1.6rem; line-height: 1; cursor: pointer; transition: transform 0.2s, background 0.2s; }
  .cx__nav:hover { transform: scale(1.1); background: var(--brand-deep); }
  .cx__dots { display: flex; justify-content: center; gap: 0.5rem; }
  .cx__dots span { width: 10px; height: 10px; border-radius: 99px; background: color-mix(in srgb, var(--brand) 25%, #fff); transition: width 0.3s, background 0.3s; }
  .cx__dots span.on { width: 30px; background: var(--brand); }

  .strip { display: grid; grid-template-columns: 1.1fr 3fr; gap: 1.5rem; align-items: center; margin-top: 2rem;
    background: color-mix(in srgb, var(--brand) 8%, #fff); border-radius: var(--radius-md); padding: 1.4rem 1.6rem; }
  .strip__belief { font-weight: 700; color: var(--brand-deep); margin: 0; font-size: var(--fs-lg); text-wrap: balance; }
  .strip__list { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; margin: 0; padding: 0; }
  .strip__list li { display: grid; justify-items: center; text-align: center; gap: 0.25rem; padding: 0 0.8rem; }
  .strip__list li + li { border-left: 1px solid var(--line); }
  .strip__icon { font-size: 2rem; line-height: 1; }
  .strip__list strong { color: var(--brand-deep); }
  .strip__list small { color: var(--muted); font-size: var(--fs-sm); }

  /* ---- 2 Four steps ---- */
  .banner { background: var(--brand); color: #fff; text-align: center; padding: 1.4rem 1.2rem; border-radius: var(--radius-md); margin-bottom: 2.2rem; border: 1px solid rgba(255, 255, 255, 0.25); }
  .banner h2 { color: #fff; text-wrap: balance; }
  .banner p { margin: 0.4rem 0 0; opacity: 0.85; text-wrap: balance; }

  .highlight { margin-bottom: 2.6rem; }
  .highlight__ribbon { display: inline-block; margin: 0 0 -0.6rem 0.6rem; position: relative; z-index: 1; background: var(--tint); color: var(--brand-deep); font-weight: 700; padding: 0.6rem 1.4rem; transform: rotate(-1deg); border-radius: 4px; }
  .highlight__row { display: grid; grid-template-columns: 1.7fr 1fr; gap: 2rem; align-items: center; }
  .highlight__photo { border-radius: var(--radius-md); overflow: hidden; }
  .highlight__brand { display: grid; justify-items: center; gap: 1rem; text-align: center; }
  .highlight__brand img { width: min(100%, 320px); height: auto; }
  .highlight__tag { margin: 0; background: #C9463F; color: #fff; font-weight: 700; padding: 0.5rem 1.2rem; border-radius: 99px; font-size: var(--fs-sm); }

  .stepper__tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; padding-top: 0.6rem; }
  .stab { display: flex; flex-direction: column; align-items: center; padding: 0; border: 0; background: none; color: #fff; font: inherit; cursor: pointer;
    opacity: 0.7; transform: scale(0.96); transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s; }
  .stab--dark { color: #3A2A2A; }
  .stab:hover { opacity: 1; transform: translateY(-5px) scale(1); }
  .stab[aria-selected='true'] { opacity: 1; transform: scale(1.05); }
  .stab__art { position: relative; z-index: 1; height: 130px; width: auto; max-width: 100%; object-fit: contain; margin-bottom: -2.4rem; }
  .stab__icon { position: relative; z-index: 1; font-size: 3.4rem; line-height: 1; margin-bottom: -1.2rem; }
  .stab__icon[hidden] { display: none; }
  .stab__pad { display: grid; justify-items: center; gap: 0.15rem; width: 100%; padding: 2.8rem 0.8rem 1rem;
    background: var(--c); color: #fff; border-radius: 50% / 42%; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25); }
  .stab--dark .stab__pad { color: #3A2A2A; }
  .stab__name { font: 700 1.15rem / 1.25 var(--font-display); }
  .stab__pad small { font-size: var(--fs-sm); opacity: 0.9; }
  .stab__n { margin-top: 0.4rem; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: #fff; color: #1F2A44; font-size: 0.95rem; }
  .stab[aria-selected='true'] .stab__art,
  .stab[aria-selected='true'] .stab__icon { animation: pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes pop { 0% { transform: scale(0.6) rotate(-12deg); } 100% { transform: scale(1) rotate(0); } }

  .stepper__bar { height: 8px; border-radius: 99px; background: rgba(255, 255, 255, 0.18); margin: 2.2rem 0 2rem; overflow: hidden; }
  .stepper__bar i { display: block; height: 100%; width: 25%; border-radius: 99px; background: var(--sun); transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1); }

  .spanel { display: grid; grid-template-columns: 1fr 1fr; gap: 2.4rem; align-items: center; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.18); border-radius: var(--radius-lg); padding: 1.6rem; animation: rise 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .spanel[hidden] { display: none; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px) scale(0.98); } to { opacity: 1; transform: none; } }
  .spanel__badge { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--c); color: #fff; font-weight: 700; margin-bottom: 0.8rem; }
  .spanel h3 { color: #fff; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .spanel__sub { color: var(--sun); font-weight: 700; margin: 0.2rem 0 1rem; }
  .spanel__text p:last-child { color: rgba(255, 255, 255, 0.9); font-size: var(--fs-lg); margin: 0; max-width: 38ch; }
  .stepper__foot { display: flex; justify-content: center; margin-top: 2rem; }

  /* ---- 3 Theory collage ---- */
  .tc { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.8rem; align-items: stretch; }
  .tc__cos { grid-column: 1 / -1; text-align: center; max-width: 52rem; margin: 0 auto; }
  .tc__diagram { margin-bottom: 1.2rem; }
  .tc__cos h3 { color: var(--brand-deep); margin: 0; }
  .tc__sub { margin: 0.2rem 0 0.8rem; font-weight: 700; color: var(--muted); }
  .tc__sub--light { color: var(--sun); margin: 0 0 0.3rem; }
  .tc__lead { color: var(--muted); max-width: 40rem; margin: 0 auto 1.2rem; }
  .tc__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: left; }
  .tc__chip { display: grid; gap: 0.3rem; background: color-mix(in srgb, #2A7D4F 10%, #fff); border-radius: var(--radius-md); padding: 1rem 1.2rem; }
  .tc__chip strong { color: #1E5C3A; }
  .tc__chip span { color: var(--muted); font-size: var(--fs-sm); }

  .tc__tic { background: var(--brand); color: #fff; border-radius: var(--radius-lg); padding: 2rem; }
  .tc__tic h3 { color: #fff; margin: 0 0 0.6rem; }
  .tc__ticp { color: rgba(255, 255, 255, 0.9); margin: 0; }
  .tc__book { align-self: center; border-radius: 42% 58% 55% 45% / 50% 45% 55% 50%; overflow: hidden; box-shadow: 0 14px 34px rgba(30, 79, 163, 0.2); }

  .acc { display: grid; gap: 0.7rem; margin-top: 1.4rem; }
  .acc__item { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0 1.2rem; transition: box-shadow 0.25s, border-color 0.25s; }
  .acc__item summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; min-height: 52px; font-weight: 700; color: var(--brand-deep); }
  .acc__item summary::-webkit-details-marker { display: none; }
  .acc__item summary::after { content: '+'; font-size: 1.5rem; line-height: 1; color: var(--brand); transition: rotate 0.3s; }
  .acc__item[open] summary::after { rotate: 135deg; }
  .acc__item p { margin: 0 0 1rem; color: var(--muted); }
  .acc--dark .acc__item { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.28); }
  .acc--dark .acc__item[open] { border-color: #fff; box-shadow: none; }
  .acc--dark summary, .acc--dark summary::after { color: #fff; }
  .acc--dark .acc__item p { color: rgba(255, 255, 255, 0.9); }

  /* ---- 4 CTA ---- */
  .cta .container { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.4rem; }
  .cta h2 { max-width: 20ch; text-wrap: balance; }
  .cta__p { max-width: 36rem; margin: 0; font-size: var(--fs-lg); color: rgba(255, 255, 255, 0.9); }
  .cta__row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1.4rem; }
  .cta__mail { color: #fff; font-weight: 700; font-size: var(--fs-lg); }

  @media (max-width: 1000px) {
    .cx__item { flex-basis: calc((100% - var(--gap)) / 2); }
    .stepper__tabs { grid-template-columns: repeat(2, 1fr); row-gap: 2rem; }
    .strip { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .cx__item { flex-basis: 100%; }
    .cx__nav { display: none; }
    .chal, .highlight__row, .spanel, .tc, .tc__pair { grid-template-columns: 1fr; }
    .strip__list { grid-template-columns: 1fr 1fr; row-gap: 1.2rem; }
    .strip__list li:nth-child(3) { border-left: 0; }
    .tc__book { max-width: 320px; margin: 0 auto; }
  }
</style>

<script is:inline>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Pain-card carousel: arrows, dots, auto-advance one card at a time, pause on hover/focus */
    document.querySelectorAll('[data-cx]').forEach(function (root) {
      var track = root.querySelector('.cx__track'), items = track.children, dotsEl = root.parentNode.querySelector('[data-dots]');
      var idx = 0, paused = false, timer;
      function metrics() {
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        var step = items[0].offsetWidth + gap;
        var visible = Math.max(1, Math.round((track.clientWidth + gap) / step));
        return { step: step, max: Math.max(0, items.length - visible) };
      }
      function renderDots() {
        var m = metrics(); dotsEl.innerHTML = '';
        if (m.max === 0) return;
        for (var i = 0; i <= m.max; i++) { var s = document.createElement('span'); if (i === idx) s.className = 'on'; dotsEl.appendChild(s); }
      }
      function go(n) {
        var m = metrics();
        idx = n > m.max ? 0 : n < 0 ? m.max : n;
        track.scrollTo({ left: idx * m.step, behavior: reduce ? 'auto' : 'smooth' });
        renderDots();
      }
      root.querySelector('[data-prev]').addEventListener('click', function () { go(idx - 1); });
      root.querySelector('[data-next]').addEventListener('click', function () { go(idx + 1); });
      track.addEventListener('scroll', function () {
        var m = metrics(), i = Math.round(track.scrollLeft / m.step);
        if (i !== idx && i >= 0 && i <= m.max) { idx = i; renderDots(); }
      }, { passive: true });
      ['mouseenter', 'focusin', 'touchstart'].forEach(function (e) { root.addEventListener(e, function () { paused = true; }); });
      ['mouseleave', 'focusout'].forEach(function (e) { root.addEventListener(e, function () { paused = false; }); });
      window.addEventListener('resize', function () { go(Math.min(idx, metrics().max)); });
      renderDots();
      if (!reduce) timer = setInterval(function () { if (!paused && metrics().max > 0) go(idx + 1); }, 4200);
    });

    /* Accessible tabs (arrow keys) for the step pedestals */
    function tabs(list, onChange) {
      var btns = Array.prototype.slice.call(list.querySelectorAll('[role=tab]'));
      function select(i, focus) {
        btns.forEach(function (b, j) {
          b.setAttribute('aria-selected', j === i ? 'true' : 'false');
          b.tabIndex = j === i ? 0 : -1;
          var p = document.getElementById(b.getAttribute('aria-controls'));
          if (p) p.hidden = j !== i;
        });
        if (focus) btns[i].focus();
        if (onChange) onChange(i);
      }
      btns.forEach(function (b, i) {
        b.addEventListener('click', function () { select(i); });
        b.addEventListener('keydown', function (e) {
          var k = e.key, n = btns.length;
          if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); select((i + 1) % n, true); }
          if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); select((i - 1 + n) % n, true); }
          if (k === 'Home') { e.preventDefault(); select(0, true); }
          if (k === 'End') { e.preventDefault(); select(n - 1, true); }
        });
      });
      return { select: select, count: btns.length };
    }

    document.querySelectorAll('[data-stepper]').forEach(function (root) {
      var bar = root.querySelector('[data-bar]'), btn = root.querySelector('[data-next-step]'), cur = 0;
      var api = tabs(root.querySelector('[role=tablist]'), function (i) {
        cur = i;
        bar.style.width = ((i + 1) / api.count * 100) + '%';
        btn.textContent = (i === api.count - 1 ? btn.dataset.restart : btn.dataset.next) + ' →';
      });
      btn.addEventListener('click', function () { api.select((cur + 1) % api.count); });
    });
  })();
</script>
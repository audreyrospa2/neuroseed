---
import Layout from '../../layouts/Layout.astro';
import AboutHero from '../../components/AboutHero.astro';
import StoryWheel from '../../components/StoryWheel.astro';
import OrgSection from '../../components/OrgSection.astro';
import TeamCarousel from '../../components/TeamCarousel.astro';
import { type Lang } from '../../i18n/utils';
import about from '../../content/pages/about.json';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const c = about[lang];
---
<Layout lang={lang} title={c.title} description={c.lead}>
  <!-- 1. Hero -->
  <AboutHero c={c.hero} />

  <!-- 2. Our story: rolling wheel -->
  <StoryWheel c={c.story} />

  <!-- 3. About Brown Rice -->
  <OrgSection id="brown-rice" c={c.brown} tone="a" img="/images/about1.jpeg" />

  <!-- 4. About Ecorazón (mirrored, tinted) -->
  <OrgSection id="ecorazon" c={c.eco} tone="b" flip tint img="/images/about2.jpeg" />

  <!-- 5. Our team: carousel -->
  <section class="section container" id="team">
    <h2>{c.team.h}</h2>
    <p class="lead">{c.team.p}</p>
    <TeamCarousel members={c.team.members} prev={c.team.prev} next={c.team.next} />
  </section>

  <!-- 6. Join us -->
  <section class="container" id="join">
    <div class="band">
      <h2>{c.join.h}</h2>
      <p>{c.join.p}</p>
      <div class="actions">
        {c.join.links.map((l) => (
          <a class={l.primary ? 'btn btn--sun' : 'text-link'} href={`/${lang}/${l.href}/`}>{l.h}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  html { scroll-behavior: smooth; }
  section[id] { scroll-margin-top: 4.5rem; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>

<style>
  /* ---- join ---- */
  .band {
    background: var(--brand); color: var(--on-brand);
    border-radius: var(--radius-lg); padding: 4.5rem 2rem; text-align: center;
    margin-block: 1.5rem 4.5rem;
  }
  .band h2 { max-width: 20ch; margin: 0 auto .8rem; }
  .band p { max-width: 44ch; margin: 0 auto 2rem; opacity: .9; }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem 1.8rem; justify-content: center; align-items: center; }
  .text-link {
    color: inherit; font-weight: 700; text-decoration: underline;
    text-underline-offset: .3em; text-decoration-thickness: 2px;
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .text-link:hover { text-decoration-color: var(--sun); }
</style>